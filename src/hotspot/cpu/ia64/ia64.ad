%{
  match(CountedLoopEnd cmp (CmpI op1 op2));

  effect(USE lbl);

  ins_cost(ALU_COST + BRANCH_COST);
  format %{ "cmp.$cmp  $op1, $op2 ; br $lbl\t# CmpI, @cmpI_loop" %}

  ins_encode %{
    __ cmp_branch($cmp$$cmpcode, C2_MacroAssembler::cmp_int, $op1$$Register, $op2$$Register, *($lbl$$label));
  %}

  ins_pipe(pipe_branch);
%}

