// Three-way compares: (a < b) ? -1 : (a > b) ? 1 : 0. For floats unordered
// gives -1 (fcmpl/dcmpl; C2 commutes the operands for fcmpg).
instruct cmpL3_reg_reg(iRegI dst, iRegL op1, iRegL op2)
%{
  match(Set dst (CmpL3 op1 op2));

  ins_cost(3 * ALU_COST);
  format %{ "cmpL3  $dst, $op1, $op2\t# @cmpL3_reg_reg" %}

  ins_encode %{
    Register d = $dst$$Register;
    __ cmp_lt(ptmp0, ptmp1, $op1$$Register, $op2$$Register);
    __ cmp_lt(ptmp2, ptmp3, $op2$$Register, $op1$$Register);
    __ mov(d, zr);
    __ adds(d, -1, zr, ptmp0);
    __ adds(d, 1, zr, ptmp2);
  %}

  ins_pipe(pipe_slow);
%}

instruct cmpF3_reg_reg(iRegI dst, fRegF op1, fRegF op2)
%{
  match(Set dst (CmpF3 op1 op2));

  ins_cost(3 * ALU_COST);
  format %{ "cmpF3  $dst, $op1, $op2\t# @cmpF3_reg_reg" %}

  ins_encode %{
    Register d = $dst$$Register;
    // ptmp0 = a < b or unordered; ptmp2 = a > b.
    __ float_cmp_preds(BoolTest::lt, $op1$$FloatRegister, $op2$$FloatRegister, ptmp0, ptmp1);
    __ float_cmp_preds(BoolTest::gt, $op1$$FloatRegister, $op2$$FloatRegister, ptmp2, ptmp3);
    __ mov(d, zr);
    __ adds(d, -1, zr, ptmp0);
    __ adds(d, 1, zr, ptmp2);
  %}

  ins_pipe(pipe_slow);
%}

instruct cmpD3_reg_reg(iRegI dst, fRegD op1, fRegD op2)
%{
  match(Set dst (CmpD3 op1 op2));

  ins_cost(3 * ALU_COST);
  format %{ "cmpD3  $dst, $op1, $op2\t# @cmpD3_reg_reg" %}

  ins_encode %{
    Register d = $dst$$Register;
    __ float_cmp_preds(BoolTest::lt, $op1$$FloatRegister, $op2$$FloatRegister, ptmp0, ptmp1);
    __ float_cmp_preds(BoolTest::gt, $op1$$FloatRegister, $op2$$FloatRegister, ptmp2, ptmp3);
    __ mov(d, zr);
    __ adds(d, -1, zr, ptmp0);
    __ adds(d, 1, zr, ptmp2);
  %}

  ins_pipe(pipe_slow);
%}

// ============================================================================
// Conditional moves: the compare, then a predicated move
// (C2-DESIGN.md section 4). dst is both an input and the result.

instruct cmovI_cmpI(iRegI dst, iRegIorL2I src, iRegIorL2I op1, iRegIorL2I op2, cmpOp cop)
%{
  match(Set dst (CMoveI (Binary cop (CmpI op1 op2)) (Binary dst src)));

  ins_cost(ALU_COST * 2);
  format %{ "cmp.$cop  $op1, $op2 ; (p6) mov $dst, $src\t# @cmovI_cmpI" %}

  ins_encode %{
    __ cmp_preds($cop$$cmpcode, C2_MacroAssembler::cmp_int, $op1$$Register, $op2$$Register, ptmp0, ptmp1);
    __ mov($dst$$Register, $src$$Register, ptmp0);
  %}

  ins_pipe(ialu_reg_reg);
%}

instruct cmovI_cmpU(iRegI dst, iRegIorL2I src, iRegIorL2I op1, iRegIorL2I op2, cmpOpU cop)
%{
