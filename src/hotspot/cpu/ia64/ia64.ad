bool Matcher::match_rule_supported(int opcode) {
  if (!has_match_rule(opcode)) {
    return false;
  }

  switch (opcode) {
    case Op_FmaF:
    case Op_FmaD:
      return UseFMA;
  }

  return true; // Per default match rules are supported.
}

