instruct convI2L_reg_reg(iRegL dst, iRegIorL2I src)
%{
  match(Set dst (ConvI2L src));

  ins_cost(ALU_COST);
  format %{ "sxt4  $dst, $src\t# i2l, @convI2L_reg_reg" %}

  ins_encode %{
    __ sxt4($dst$$Register, $src$$Register);
  %}

  ins_pipe(ialu_reg);
%}

// Lazy ints: the int is the long's low 32 bits; the upper half may stay.
instruct convL2I_reg(iRegI dst, iRegL src)
%{
  match(Set dst (ConvL2I src));

  ins_cost(ALU_COST);
  format %{ "mov  $dst, $src\t# l2i, @convL2I_reg" %}

  ins_encode %{
    __ mov($dst$$Register, $src$$Register);
  %}

  ins_pipe(ialu_reg);
%}

// int -> unsigned long
instruct convI2UL_reg_reg(iRegL dst, iRegIorL2I src, immL_32bits mask)
%{
  match(Set dst (AndL (ConvI2L src) mask));

  ins_cost(ALU_COST);
  format %{ "zxt4  $dst, $src\t# i2ul, @convI2UL_reg_reg" %}

  ins_encode %{
    __ zxt4($dst$$Register, $src$$Register);
  %}

  ins_pipe(ialu_reg);
%}

instruct convP2I(iRegI dst, iRegP src)
%{
  match(Set dst (ConvL2I (CastP2X src)));

  ins_cost(ALU_COST);
  format %{ "mov  $dst, $src\t# ptr -> int, @convP2I" %}

  ins_encode %{
    __ mov($dst$$Register, $src$$Register);
  %}

  ins_pipe(ialu_reg);
%}

// f2d is exact; fnorm.d makes the value double-typed for stfd (ISA-NOTES.md).
instruct convF2D_reg(fRegD dst, fRegF src)
%{
  match(Set dst (ConvF2D src));

  ins_cost(ALU_COST);
  format %{ "fnorm.d  $dst, $src\t# f2d, @convF2D_reg" %}

  ins_encode %{
    __ fnorm_d($dst$$FloatRegister, $src$$FloatRegister);
  %}

  ins_pipe(fp_default);
%}

instruct convD2F_reg(fRegF dst, fRegD src)
%{
  match(Set dst (ConvD2F src));

  ins_cost(ALU_COST);
  format %{ "fnorm.s  $dst, $src\t# d2f, @convD2F_reg" %}

  ins_encode %{
    __ fnorm_s($dst$$FloatRegister, $src$$FloatRegister);
  %}

  ins_pipe(fp_default);
%}

// Integer to FP: setf.sig, fcvt.xf (exact), then one rounding (fnorm).
instruct convI2F_reg_reg(fRegF dst, iRegIorL2I src)
%{
  match(Set dst (ConvI2F src));

  ins_cost(XFER_COST);
  format %{ "sxt4 t1, $src ; setf.sig ; fcvt.xf ; fnorm.s  $dst\t# i2f, @convI2F_reg_reg" %}

  ins_encode %{
    __ sxt4(t1, $src$$Register);
    __ setf_sig($dst$$FloatRegister, t1);
    __ fcvt_xf($dst$$FloatRegister, $dst$$FloatRegister);
    __ fnorm_s($dst$$FloatRegister, $dst$$FloatRegister);
  %}

  ins_pipe(fp_default);
%}

instruct convI2D_reg_reg(fRegD dst, iRegIorL2I src)
%{
  match(Set dst (ConvI2D src));

  ins_cost(XFER_COST);
  format %{ "sxt4 t1, $src ; setf.sig ; fcvt.xf ; fnorm.d  $dst\t# i2d, @convI2D_reg_reg" %}

  ins_encode %{
    __ sxt4(t1, $src$$Register);
    __ setf_sig($dst$$FloatRegister, t1);
    __ fcvt_xf($dst$$FloatRegister, $dst$$FloatRegister);
    __ fnorm_d($dst$$FloatRegister, $dst$$FloatRegister);
  %}

  ins_pipe(fp_default);
%}

instruct convL2F_reg_reg(fRegF dst, iRegL src)
%{
  match(Set dst (ConvL2F src));

  ins_cost(XFER_COST);
  format %{ "setf.sig ; fcvt.xf ; fnorm.s  $dst, $src\t# l2f, @convL2F_reg_reg" %}

  ins_encode %{
    __ setf_sig($dst$$FloatRegister, $src$$Register);
    __ fcvt_xf($dst$$FloatRegister, $dst$$FloatRegister);
    __ fnorm_s($dst$$FloatRegister, $dst$$FloatRegister);
  %}

  ins_pipe(fp_default);
%}

instruct convL2D_reg_reg(fRegD dst, iRegL src)
%{
  match(Set dst (ConvL2D src));

  ins_cost(XFER_COST);
  format %{ "setf.sig ; fcvt.xf ; fnorm.d  $dst, $src\t# l2d, @convL2D_reg_reg" %}

  ins_encode %{
    __ setf_sig($dst$$FloatRegister, $src$$Register);
    __ fcvt_xf($dst$$FloatRegister, $dst$$FloatRegister);
    __ fnorm_d($dst$$FloatRegister, $dst$$FloatRegister);
  %}

  ins_pipe(fp_default);
%}

// FP to integer, Java semantics (NaN -> 0, saturating): java_fp_to_int/long
// (f6, t1, p6-p9).
instruct convF2I_reg_reg(iRegI dst, fRegF src)
%{
  match(Set dst (ConvF2I src));

  ins_cost(XFER_COST);
  format %{ "java_fp_to_int  $dst, $src\t# f2i, @convF2I_reg_reg" %}

  ins_encode %{
    __ java_fp_to_int($dst$$Register, $src$$FloatRegister);
  %}

  ins_pipe(pipe_slow);
%}

