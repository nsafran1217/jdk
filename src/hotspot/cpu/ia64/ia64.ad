// A pointer shifted right (card-table address computation).
instruct urShiftP_reg_imm(iRegL dst, iRegP src1, immI src2)
%{
  match(Set dst (URShiftL (CastP2X src1) src2));

  ins_cost(ALU_COST);
  format %{ "shr.u  $dst, p2x($src1), ($src2 & 0x3f)\t# ptr, @urShiftP_reg_imm" %}

  ins_encode %{
    __ shru_imm($dst$$Register, $src1$$Register, (uint32_t)$src2$$constant & 0x3f);
  %}

  ins_pipe(ialu_reg);
%}

// (p < q) ? -1 : 0
instruct cmpLTMask_reg_reg(iRegI dst, iRegIorL2I p, iRegIorL2I q)
%{
  match(Set dst (CmpLTMask p q));

  ins_cost(3 * ALU_COST);
  format %{ "cmp4.lt p6, p7 = $p, $q ; $dst = p6 ? -1 : 0\t# @cmpLTMask_reg_reg" %}

  ins_encode %{
    __ cmp4_lt(ptmp0, ptmp1, $p$$Register, $q$$Register);
    __ mov($dst$$Register, zr);
    __ adds($dst$$Register, -1, zr, ptmp0);
  %}

  ins_pipe(ialu_reg_reg);
%}

// (p < 0) ? -1 : 0: the sign bit, extracted signed.
instruct cmpLTMask_reg_zero(iRegI dst, iRegIorL2I p, immI0 zero)
%{
  match(Set dst (CmpLTMask p zero));

  ins_cost(ALU_COST);
  format %{ "extr  $dst, $p, 31, 1\t# @cmpLTMask_reg_zero" %}

  ins_encode %{
    __ extr($dst$$Register, $p$$Register, 31, 1);
  %}

  ins_pipe(ialu_reg);
%}

// Min and max (C2's loop optimizations create these): a compare and two
// complementary predicated moves, safe whichever operand dst aliases.
instruct minI_reg_reg(iRegI dst, iRegIorL2I src1, iRegIorL2I src2)
%{
  match(Set dst (MinI src1 src2));

  ins_cost(3 * ALU_COST);
  format %{ "cmp4.lt p6, p7 = $src1, $src2 ; (p6) mov $dst, $src1 ; (p7) mov $dst, $src2\t# @minI_reg_reg" %}

  ins_encode %{
    __ cmp4_lt(ptmp0, ptmp1, $src1$$Register, $src2$$Register);
    __ mov($dst$$Register, $src1$$Register, ptmp0);
    __ mov($dst$$Register, $src2$$Register, ptmp1);
  %}

  ins_pipe(ialu_reg_reg);
%}

instruct maxI_reg_reg(iRegI dst, iRegIorL2I src1, iRegIorL2I src2)
%{
  match(Set dst (MaxI src1 src2));

  ins_cost(3 * ALU_COST);
  format %{ "cmp4.lt p6, p7 = $src1, $src2 ; (p6) mov $dst, $src2 ; (p7) mov $dst, $src1\t# @maxI_reg_reg" %}

  ins_encode %{
    __ cmp4_lt(ptmp0, ptmp1, $src1$$Register, $src2$$Register);
    __ mov($dst$$Register, $src2$$Register, ptmp0);
    __ mov($dst$$Register, $src1$$Register, ptmp1);
  %}

  ins_pipe(ialu_reg_reg);
%}

// ============================================================================
// Floating point
//
// Single-precision arithmetic rounds to single (.s), double to double (.d),
// on sf0: Java's rounding (C2-DESIGN.md section 10).

instruct addF_reg_reg(fRegF dst, fRegF src1, fRegF src2)
%{
  match(Set dst (AddF src1 src2));

  ins_cost(FMUL_COST);
  format %{ "fadd.s  $dst, $src1, $src2\t# @addF_reg_reg" %}

  ins_encode %{
    __ fadd_s($dst$$FloatRegister, $src1$$FloatRegister, $src2$$FloatRegister);
  %}

  ins_pipe(fp_default);
%}

