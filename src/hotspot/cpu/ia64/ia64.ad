// ============================================================================
// Compare and branch (C2-DESIGN.md section 4)
//
// The compare is fused into its branch: an IA-64 compare needs the relation
// at compare time. Every branch is the imm21 bundle form (+/-16 MiB), so
// there are no short or far variants.

instruct branch(label lbl)
%{
  match(Goto);

  effect(USE lbl);

  ins_cost(BRANCH_COST);
  format %{ "br  $lbl\t# @branch" %}

  ins_encode %{
    __ br(*($lbl$$label));
  %}

  ins_pipe(pipe_branch);
%}

instruct cmpI_branch(cmpOp cmp, iRegIorL2I op1, iRegIorL2I op2, label lbl)
%{
  match(If cmp (CmpI op1 op2));

  effect(USE lbl);

  ins_cost(ALU_COST + BRANCH_COST);
  format %{ "cmp.$cmp  $op1, $op2 ; br $lbl\t# CmpI, @cmpI_branch" %}

  ins_encode %{
    __ cmp_branch($cmp$$cmpcode, C2_MacroAssembler::cmp_int, $op1$$Register, $op2$$Register, *($lbl$$label));
  %}

  ins_pipe(pipe_branch);
%}

instruct cmpI_zero_branch(cmpOp cmp, iRegIorL2I op1, immI0 zero, label lbl)
%{
  match(If cmp (CmpI op1 zero));

  effect(USE lbl);

  ins_cost(ALU_COST + BRANCH_COST);
  format %{ "cmp.$cmp  $op1, r0 ; br $lbl\t# CmpI, @cmpI_zero_branch" %}

  ins_encode %{
    __ cmp_branch($cmp$$cmpcode, C2_MacroAssembler::cmp_int, $op1$$Register, zr, *($lbl$$label));
  %}

  ins_pipe(pipe_branch);
%}

