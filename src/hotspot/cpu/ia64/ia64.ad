// ============================================================================
// Memory: loads and stores (C2-DESIGN.md section 5). C2_MacroAssembler::access
// emits each access as one bundle, so the node starts at the bundle that can
// fault.

instruct loadB(iRegI dst, memory mem)
%{
  match(Set dst (LoadB mem));

  ins_cost(LOAD_COST);
  format %{ "ld1 + sxt1, byte  $dst, $mem\t# @loadB" %}

  ins_encode %{
    __ access(C2_MacroAssembler::op_ld1, $dst$$reg, as_Register($mem$$base), $mem$$disp);
    __ sxt1($dst$$Register, $dst$$Register);
  %}

  ins_pipe(pipe_class_memory);
%}

instruct loadB2L(iRegL dst, memory mem)
%{
  match(Set dst (ConvI2L (LoadB mem)));

  ins_cost(LOAD_COST);
  format %{ "ld1 + sxt1, byte -> long  $dst, $mem\t# @loadB2L" %}

  ins_encode %{
    __ access(C2_MacroAssembler::op_ld1, $dst$$reg, as_Register($mem$$base), $mem$$disp);
    __ sxt1($dst$$Register, $dst$$Register);
  %}

  ins_pipe(pipe_class_memory);
%}

instruct loadUB(iRegI dst, memory mem)
%{
  match(Set dst (LoadUB mem));

  ins_cost(LOAD_COST);
  format %{ "ld1, ubyte  $dst, $mem\t# @loadUB" %}

  ins_encode %{
    __ access(C2_MacroAssembler::op_ld1, $dst$$reg, as_Register($mem$$base), $mem$$disp);
    
  %}

  ins_pipe(pipe_class_memory);
