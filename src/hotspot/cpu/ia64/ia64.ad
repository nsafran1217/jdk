  match(Set dst (CMoveL (Binary cop (CmpUL op1 op2)) (Binary dst src)));

  ins_cost(ALU_COST * 2);
  format %{ "cmp.$cop  $op1, $op2 ; (p6) mov $dst, $src\t# @cmovL_cmpUL" %}

  ins_encode %{
    __ cmp_preds($cop$$cmpcode, C2_MacroAssembler::cmp_ulong, $op1$$Register, $op2$$Register, ptmp0, ptmp1);
    __ mov($dst$$Register, $src$$Register, ptmp0);
  %}

  ins_pipe(ialu_reg_reg);
%}

