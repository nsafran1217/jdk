// Should the Matcher clone shifts on addressing modes, expecting them
// to be subsumed into complex addressing expressions or compute them
// into registers? There is only base+offset14 (indOffset14), so only a
// constant offset is worth cloning into each use.
bool Matcher::pd_clone_address_expressions(AddPNode* m, Matcher::MStack& mstack, VectorSet& address_visited) {
  return clone_base_plus_offset_address(m, mstack, address_visited);
}

%}

//----------ENCODING BLOCK-----------------------------------------------------
// This block specifies the encoding classes used by the compiler to
// output byte streams.  Encoding classes are parameterized macros
// used by Machine Instruction Nodes in order to generate the bit
// encoding of the instruction.  Operands specify their base encoding
// interface with the interface keyword.  There are currently
// supported four interfaces, REG_INTER, CONST_INTER, MEMORY_INTER, &
// COND_INTER.  REG_INTER causes an operand to generate a function
// which returns its register number when queried.  CONST_INTER causes
// an operand to generate a function which returns the value of the
// constant when queried.  MEMORY_INTER causes an operand to generate
// four functions which return the Base Register, the Index Register,
// the Scale Value, and the Offset Value of the operand when queried.
// COND_INTER causes an operand to generate six functions which return
// the encoding code (ie - encoding bits for the instruction)
// associated with each basic boolean condition for a conditional
// instruction.
//
// Instructions specify two basic values for encoding.  Again, a
// function is available to check if the constant displacement is an
// oop. They use the ins_encode keyword to specify their encoding
// classes (which must be a sequence of enc_class names, and their
// parameters, specified in the encoding block), and they use the
// opcode keyword to specify, in order, their primary, secondary, and
// tertiary opcode.  Only the opcode sections which a particular
// instruction needs for encoding need to be specified.
encode %{
  // Java calls: the seven-bundle cell form (MacroAssembler::far_call,
  // NativeCall), whose size MachCallStaticJavaNode::ret_addr_offset assumes.
  enc_class ia64_enc_java_static_call(method meth) %{
    address addr = (address)$meth$$method;
    if (!_method) {
      // A call to a runtime wrapper, e.g. new, new_typeArray_Java, uncommon_trap.
      __ far_call(addr, runtime_call_Relocation::spec());
    } else if (_method->intrinsic_id() == vmIntrinsicID::_ensureMaterializedForStackWalk) {
      // The nops keep the size of the elided call to
      // JVM_EnsureMaterializedForStackWalk.
      for (int i = 0; i < NativeCall::instruction_size / BytesPerBundle; i++) {
        __ nop();
      }
      __ block_comment("call JVM_EnsureMaterializedForStackWalk (elided)");
    } else {
      int method_index = resolved_method_index(masm);
      RelocationHolder rspec = _optimized_virtual ? opt_virtual_call_Relocation::spec(method_index)
                                                  : static_call_Relocation::spec(method_index);
      address call_pc = __ pc();
      __ far_call(addr, rspec);

      // Emit stub for static call
      address stub = CompiledDirectCall::emit_to_interp_stub(masm, call_pc);
      if (stub == nullptr) {
        ciEnv::current()->record_failure("CodeCache is full");
        return;
      }
    }
  %}

  // As C1's ic_call: the CompiledICData* in a movl to t1 (filled in when the
  // nmethod is installed), then the call through its cell. The callee's UEP
  // checks the receiver against it (MacroAssembler::ic_check).
  enc_class ia64_enc_java_dynamic_call(method meth) %{
    int method_index = resolved_method_index(masm);
    address movl_pc = __ pc();
    __ movl(t1, (uint64_t)(uintptr_t)Universe::non_oop_word());
    __ far_call((address)$meth$$method, virtual_call_Relocation::spec(movl_pc, method_index));
  %}

  // Calls to the runtime. A target in the code cache (a stub or blob) is
  // called as code; a C function, or a stub that starts with a descriptor,
  // through the descriptor (call_c reads it at emission time). The anchor needs the return address, which a C2 runtime
  // stub does not otherwise store: mov ip; adds; adds; st8 put it in
  // last_Java_pc before the call. MachCallRuntimeNode::ret_addr_offset has
  // both sizes.
  enc_class ia64_enc_java_to_runtime(method meth) %{
    address entry = (address)$meth$$method;
    if (!call_through_descriptor(entry)) {
      __ far_call(entry, runtime_call_Relocation::spec());
    } else {
      int start = __ offset();
      __ mov_from_ip(t0);
      __ adds(t0, 8 * BytesPerBundle, t0);
      __ adds(t1, in_bytes(JavaThread::last_Java_pc_offset()), Rthread);
      __ Assembler::st8(t1, t0);
      __ call_c(entry);
      assert(__ offset() - start == 8 * BytesPerBundle, "ret_addr_offset");
    }
  %}
%}

//----------FRAME--------------------------------------------------------------
// Definition of frame structure and management information.
//
//  S T A C K   L A Y O U T    Allocators stack-slot number
//                             |   (to get allocators register number
//  G  Owned by    |        |  v    add OptoReg::stack0())
//  r   CALLER     |        |
//  o     |        +--------+      pad to even-align allocators stack-slot
//  w     V        |  pad0  |        numbers; owned by CALLER
//  t   -----------+--------+----> Matcher::_in_arg_limit, unaligned
//  h     ^        |   in   |  5
//        |        |  args  |  4   Holes in incoming args owned by SELF
//  |     |        |        |  3
//  |     |        +--------+
//  V     |        | old out|      The caller's psABI scratch area:
//        |    old |preserve|      16 bytes (4 slots), even aligned
//        |     SP-+--------+----> Matcher::_old_SP, even aligned
//        |        |   in   |  3   return address and caller's fp
//     Owned by    |preserve|      (4 slots: fp - 8, fp - 16)
//       SELF      +--------+
//        |        |  pad2  |  2   pad to align old SP
//        |        +--------+  1
//        |        | locks  |  0
//        |        +--------+----> OptoReg::stack0(), even aligned
//        |        |  pad1  | 11   pad to align new SP
//        |        +--------+
//        |        |        | 10
//        |        | spills |  9   spills
//        V        |        |  8   (pad0 slot for callee)
//      -----------+--------+----> Matcher::_out_arg_limit, unaligned
//        ^        |  out   |  7
//        |        |  args  |  6   Holes in outgoing args owned by CALLEE
//     Owned by    +--------+
//      CALLEE     | new out|  6   our psABI scratch area: any C callee
//        |    new |preserve|      may write it (FRAME-DESIGN.md 4.1)
//        |     SP-+--------+----> Matcher::_new_SP, even aligned
//        |        |        |
//
// Note 1: Only region 8-11 is determined by the allocator.  Region 0-5 is
//         known from SELF's arguments and the Java calling convention.
//         Region 6-7 is determined per call site.
// Note 2: If the calling convention leaves holes in the incoming argument
//         area, those holes are owned by SELF.  Holes in the outgoing area
//         are owned by the CALLEE.  Holes should not be necessary in the
//         incoming area, as the Java calling convention is completely under
//         the control of the AD file.  Doubles can be sorted and packed to
//         avoid holes.  Holes in the outgoing arguments may be necessary for
//         varargs C calling conventions.
// Note 3: Region 0-3 is even aligned, with pad2 as needed.  Region 3-5 is
//         even aligned with pad0 as needed.
//         Region 6 is even aligned.  Region 6-7 is NOT even aligned;
//         region 6-11 is even aligned; it may be padded out more so that
//         the region from SP to FP meets the minimum stack alignment.
// Note 4: For I2C adapters, the incoming FP may not meet the minimum stack
//         alignment.  Region 11, pad1, may be dynamically extended so that
//         SP meets the minimum alignment.

frame %{
  // These three registers define part of the calling convention
  // between compiled code and the interpreter.

  // Inline Cache Register or Method for I2C: t1, where ic_check reads the
  // CompiledICData* (C2-DESIGN.md section 1).
  inline_cache_reg(R3);

  // Number of stack slots consumed by locking an object
  sync_stack_slots(1 * VMRegImpl::slots_per_word);

  // Compiled code's Frame Pointer
  frame_pointer(R12);

  // Interpreter stores its frame pointer in a register which is
  // stored to the stack by I2CAdaptors.
  // I2CAdaptors convert from interpreted java to compiled java.
  interpreter_frame_pointer(R4);

  // Stack alignment requirement
  stack_alignment(StackAlignmentInBytes); // Alignment size in bytes (128-bit -> 16 bytes)

  // Number of outgoing stack slots killed above the out_preserve_stack_slots
  // for calls to C.  Supports the var-args backing area for register parms.
  // The psABI scratch area is already the out-preserve area.
  varargs_C_out_slots_killed(0);

  // The after-PROLOG location of the return address.  Location of
  // return address specifies a type (REG or STACK) and a number
  // representing the register number (i.e. - use a register name) or
  // stack slot.
  // The return address is at fp - 8, two slots below the old SP, above the
  // locks (fixed slots); the layout is riscv's, so is the expression.
  return_addr(STACK - 2 +
              align_up((Compile::current()->in_preserve_stack_slots() +
                        Compile::current()->fixed_slots()),
                       stack_alignment_in_slots()));

  // Location of compiled Java return values: r8 / f8, as C.
  return_value
  %{
    assert(ideal_reg >= Op_RegI && ideal_reg <= Op_RegL,
           "only return normal values");

    static const int lo[Op_RegL + 1] = { // enum name
      0,                                 // Op_Node
      0,                                 // Op_Set
      R8_num,                            // Op_RegN
      R8_num,                            // Op_RegI
      R8_num,                            // Op_RegP
      F8_num,                            // Op_RegF
      F8_num,                            // Op_RegD
      R8_num                             // Op_RegL
    };

    static const int hi[Op_RegL + 1] = { // enum name
      0,                                 // Op_Node
      0,                                 // Op_Set
      OptoReg::Bad,                      // Op_RegN
      OptoReg::Bad,                      // Op_RegI
      R8_H_num,                          // Op_RegP
      OptoReg::Bad,                      // Op_RegF
      F8_H_num,                          // Op_RegD
      R8_H_num                           // Op_RegL
    };

    return OptoRegPair(hi[ideal_reg], lo[ideal_reg]);
  %}
%}

//----------ATTRIBUTES---------------------------------------------------------
//----------Operand Attributes-------------------------------------------------
op_attrib op_cost(1);        // Required cost attribute

//----------Instruction Attributes---------------------------------------------
ins_attrib ins_cost(DEFAULT_COST); // Required cost attribute
ins_attrib ins_size(128);       // Required size attribute (in bits): a bundle
ins_attrib ins_short_branch(0); // Required flag: is this instruction
                                // a non-matching short branch variant
                                // of some long branch?
ins_attrib ins_alignment(1);    // Required alignment attribute (must
                                // be a power of 2) specifies the
                                // alignment that some part of the
                                // instruction (not necessarily the
                                // start) requires.  If > 1, a
                                // compute_padding() function must be
                                // provided for the instruction

//----------OPERANDS-----------------------------------------------------------
// Operand definitions must precede instruction definitions for correct parsing
// in the ADLC because operands constitute user defined types which are used in
// instruction definitions.

//----------Simple Operands----------------------------------------------------

// Integer operands 32 bit
// 32 bit immediate
operand immI()
%{
  match(ConI);

  op_cost(0);
  format %{ %}
  interface(CONST_INTER);
%}

// 32 bit zero
operand immI0()
%{
  predicate(n->get_int() == 0);
  match(ConI);

  op_cost(0);
  format %{ %}
  interface(CONST_INTER);
%}

// 32 bit unit increment
operand immI_1()
%{
  predicate(n->get_int() == 1);
  match(ConI);

  op_cost(0);
  format %{ %}
  interface(CONST_INTER);
%}

// 32 bit unit decrement
operand immI_M1()
%{
  predicate(n->get_int() == -1);
  match(ConI);

  op_cost(0);
  format %{ %}
  interface(CONST_INTER);
%}

// The signed 8-bit immediate of compares and logical ops (A8, A3, A5).
operand immI8()
%{
  predicate(ia64::is_simm8(n->get_int()));
  match(ConI);

  op_cost(0);
  format %{ %}
  interface(CONST_INTER);
%}

// The signed 14-bit immediate of adds (A4).
operand immI14()
%{
  predicate(ia64::is_simm14(n->get_int()));
  match(ConI);

  op_cost(0);
  format %{ %}
  interface(CONST_INTER);
%}

// Shift counts 0-31 and 0-63.
operand immI_0_31()
%{
  predicate(0 <= n->get_int() && n->get_int() <= 31);
  match(ConI);

  op_cost(0);
  format %{ %}
  interface(CONST_INTER);
%}

operand immI_0_63()
%{
  predicate(0 <= n->get_int() && n->get_int() <= 63);
  match(ConI);

  op_cost(0);
  format %{ %}
  interface(CONST_INTER);
%}


// Shift amounts for shladd (1-4)
operand immI_1_4()
%{
  predicate(1 <= n->get_int() && n->get_int() <= 4);
  match(ConI);

  op_cost(0);
  format %{ %}
  interface(CONST_INTER);
%}

// Long Immediate: 64-bit
operand immL()
%{
  match(ConL);

  op_cost(0);
  format %{ %}
  interface(CONST_INTER);
%}

// Long Immediate: zero
operand immL0()
%{
  predicate(n->get_long() == 0);
  match(ConL);

  op_cost(0);
  format %{ %}
  interface(CONST_INTER);
%}

// Long Immediate: the signed 8-bit compare and logical immediate
operand immL8()
%{
  predicate(ia64::is_simm8(n->get_long()));
  match(ConL);

  op_cost(0);
  format %{ %}
  interface(CONST_INTER);
%}

// Long Immediate: the signed 14-bit adds immediate (addresses: indOffset14)
operand immL14()
%{
  predicate(ia64::is_simm14(n->get_long()));
  match(ConL);

  op_cost(0);
  format %{ %}
  interface(CONST_INTER);
%}


// Long Immediate: low 32-bit mask
operand immL_32bits()
%{
  predicate(n->get_long() == 0xFFFFFFFFL);
  match(ConL);

  op_cost(0);
  format %{ %}
  interface(CONST_INTER);
%}

// Pointer Immediate
operand immP()
%{
  match(ConP);

  op_cost(0);
  format %{ %}
  interface(CONST_INTER);
%}

// Null Pointer Immediate
operand immP0()
%{
  predicate(n->get_ptr() == 0);
  match(ConP);

  op_cost(0);
  format %{ %}
  interface(CONST_INTER);
%}

// Pointer Immediate One
// this is used in object initialization (initial object header)
operand immP_1()
%{
  predicate(n->get_ptr() == 1);
  match(ConP);

  op_cost(0);
  format %{ %}
  interface(CONST_INTER);
%}

// Narrow Klass Pointer Immediate
operand immNKlass()
%{
  match(ConNKlass);

  op_cost(0);
  format %{ %}
  interface(CONST_INTER);
%}

// Float Immediate
operand immF()
%{
  match(ConF);

  op_cost(0);
  format %{ %}
  interface(CONST_INTER);
%}

// Float Immediate: +0.0f (f0)
operand immF0()
%{
  predicate(jint_cast(n->getf()) == 0);
  match(ConF);

  op_cost(0);
  format %{ %}
  interface(CONST_INTER);
%}

// Double Immediate
operand immD()
%{
  match(ConD);

  op_cost(0);
  format %{ %}
  interface(CONST_INTER);
%}

// Double Immediate: +0.0d (f0)
operand immD0()
%{
  predicate(jlong_cast(n->getd()) == 0);
  match(ConD);

  op_cost(0);
  format %{ %}
  interface(CONST_INTER);
%}

// Register Operands

// Integer 32 bit Register Operands
operand iRegI()
%{
  constraint(ALLOC_IN_RC(int_reg));
  match(RegI);
  match(iRegI_R8);
  op_cost(0);
  format %{ %}
  interface(REG_INTER);
%}

// Integer 32 bit Register, r8 (return value)
operand iRegI_R8()
%{
  constraint(ALLOC_IN_RC(int_r8_reg));
  match(RegI);
  match(iRegI);
  op_cost(0);
  format %{ %}
  interface(REG_INTER);
%}

// Integer 64 bit Register Operands
operand iRegL()
%{
  constraint(ALLOC_IN_RC(long_reg));
  match(RegL);
  match(iRegL_R8);
  op_cost(0);
  format %{ %}
  interface(REG_INTER);
%}

// Long 64 bit Register, r8 (return value)
operand iRegL_R8()
%{
  constraint(ALLOC_IN_RC(r8_reg));
  match(RegL);
  match(iRegL);
  op_cost(0);
  format %{ %}
  interface(REG_INTER);
%}


// A long used as an int: lazy ints make the long's register the int's (its
// low 32 bits), so int consumers fold ConvL2I away (iRegIorL2I below).
operand iRegL2I(iRegL reg)
%{
  op_cost(0);

  match(ConvL2I reg);

  format %{ "l2i($reg)" %}

  interface(REG_INTER)
%}

// Fixed registers for ClearArray.
operand iRegL_R20()
%{
  constraint(ALLOC_IN_RC(r20_reg));
  match(RegL);
  match(iRegL);
  op_cost(0);
  format %{ %}
  interface(REG_INTER);
%}

operand iRegP_R21()
%{
  constraint(ALLOC_IN_RC(r21_reg));
  match(RegP);
  match(iRegPNoSp);
  op_cost(0);
  format %{ %}
  interface(REG_INTER);
%}

// Pointer Register Operands, as an input: may also be fp, Rthread or sp
operand iRegP()
%{
  constraint(ALLOC_IN_RC(any_ptr_reg));
  match(RegP);
  match(iRegPNoSp);
  match(iRegP_R8);
  match(iRegP_R14);
  match(iRegP_R28);
  match(javaThread_RegP);
  op_cost(0);
  format %{ %}
  interface(REG_INTER);
%}

// Pointer Register Operands, allocatable (results)
operand iRegPNoSp()
%{
  constraint(ALLOC_IN_RC(ptr_reg));
  match(RegP);
  op_cost(0);
  format %{ %}
  interface(REG_INTER);
%}

// Pointer 64 bit Register r8 (return value, exception oop)
operand iRegP_R8()
%{
  constraint(ALLOC_IN_RC(r8_reg));
  match(RegP);
  match(iRegPNoSp);
  op_cost(0);
  format %{ %}
  interface(REG_INTER);
%}

// Pointer 64 bit Register r14 (Rmethod at calls)
operand iRegP_R14()
%{
  constraint(ALLOC_IN_RC(r14_reg));
  match(RegP);
  match(iRegPNoSp);
  op_cost(0);
  format %{ %}
  interface(REG_INTER);
%}

// Pointer 64 bit Register r28 (exception pc)
operand iRegP_R28()
%{
  constraint(ALLOC_IN_RC(r28_reg));
  match(RegP);
  match(iRegPNoSp);
  op_cost(0);
  format %{ %}
  interface(REG_INTER);
%}

// Narrow Pointer Register Operands (narrow klass)
operand iRegN()
%{
  constraint(ALLOC_IN_RC(int_reg));
  match(RegN);
  op_cost(0);
  format %{ %}
  interface(REG_INTER);
%}

// Java Thread Register
operand javaThread_RegP(iRegP reg)
%{
  constraint(ALLOC_IN_RC(thread_reg)); // Rthread (r5)
  match(reg);
  op_cost(0);
  format %{ %}
  interface(REG_INTER);
%}

// Float Register Operands
operand fRegF()
%{
  constraint(ALLOC_IN_RC(float_reg));
  match(RegF);

  op_cost(0);
  format %{ %}
  interface(REG_INTER);
%}

// Double Register Operands
operand fRegD()
%{
  constraint(ALLOC_IN_RC(double_reg));
  match(RegD);

  op_cost(0);
  format %{ %}
  interface(REG_INTER);
%}

// Flags register (the p10/p11 pair), used as output of compare logic
operand rFlagsReg()
%{
  constraint(ALLOC_IN_RC(int_flags));
  match(RegFlags);

  op_cost(0);
  format %{ "RFLAGS" %}
  interface(REG_INTER);
%}

// Special Registers

// Method Register
operand inline_cache_RegP(iRegP reg)
%{
  constraint(ALLOC_IN_RC(r14_reg)); // Rmethod
  match(reg);
  match(iRegPNoSp);
  op_cost(0);
  format %{ %}
  interface(REG_INTER);
%}

//----------Memory Operands----------------------------------------------------
// There is no displacement addressing (C2-DESIGN.md section 5): `indirect`
// is [reg]; `indOffset14` is base + a 14-bit offset, emitted as one
// { adds t0 = off, base ;; ld/st [t0] } bundle so that the memory node
// itself starts at the faulting bundle (implicit null checks).

operand indirect(iRegP reg)
%{
  constraint(ALLOC_IN_RC(any_ptr_reg));
  match(reg);
  op_cost(0);
  format %{ "[$reg]" %}
  interface(MEMORY_INTER) %{
    base($reg);
    index(0xffffffff);
    scale(0x0);
    disp(0x0);
  %}
%}

operand indOffset14(iRegP reg, immL14 off)
%{
  constraint(ALLOC_IN_RC(any_ptr_reg));
  match(AddP reg off);
  op_cost(0);
  format %{ "[$reg, $off]" %}
  interface(MEMORY_INTER) %{
    base($reg);
    index(0xffffffff);
    scale(0x0);
    disp($off);
  %}
%}

//----------Special Memory Operands--------------------------------------------
// Stack Slot Operand - This operand is used for loading and storing temporary
//                      values on the stack where a match requires a value to
//                      flow through memory.
operand stackSlotI(sRegI reg)
%{
  constraint(ALLOC_IN_RC(stack_slots));
  // No match rule because this operand is only generated in matching
  // match(RegI);
  format %{ "[$reg]" %}
  interface(MEMORY_INTER) %{
    base(0x0c);   // sp
    index(0xffffffff);
    scale(0x0);
    disp($reg);   // Stack Offset
  %}
%}

operand stackSlotF(sRegF reg)
%{
  constraint(ALLOC_IN_RC(stack_slots));
  // No match rule because this operand is only generated in matching
  // match(RegF);
  format %{ "[$reg]" %}
  interface(MEMORY_INTER) %{
    base(0x0c);   // sp
    index(0xffffffff);
    scale(0x0);
    disp($reg);   // Stack Offset
  %}
%}

operand stackSlotD(sRegD reg)
%{
  constraint(ALLOC_IN_RC(stack_slots));
  // No match rule because this operand is only generated in matching
  // match(RegD);
  format %{ "[$reg]" %}
  interface(MEMORY_INTER) %{
    base(0x0c);   // sp
    index(0xffffffff);
    scale(0x0);
    disp($reg);   // Stack Offset
  %}
%}

operand stackSlotL(sRegL reg)
%{
  constraint(ALLOC_IN_RC(stack_slots));
  // No match rule because this operand is only generated in matching
  // match(RegL);
  format %{ "[$reg]" %}
  interface(MEMORY_INTER) %{
    base(0x0c);   // sp
    index(0xffffffff);
    scale(0x0);
    disp($reg);   // Stack Offset
  %}
%}

// Comparison Operands
// NOTE: Label is a predefined operand which should not be redefined in
//       the AD file. It is generically handled within the ADLC.

//----------Conditional Branch Operands----------------------------------------
// Comparison Op  - This is the operation of the comparison, and is limited to
//                  the following set of codes:
//                  L (<), LE (<=), G (>), GE (>=), E (==), NE (!=)
//
// Other attributes of the comparison, such as unsignedness, are specified
// by the comparison instruction that sets a condition code flags register.
// That result is represented by a flags operand whose subtype is appropriate
// to the unsignedness (etc.) of the comparison.
//
// Later, the instruction which matches both the Comparison Op (a Bool) and
// the flags (produced by the Cmp) specifies the coding of the comparison op
// by matching a specific subtype of Bool operand below, such as cmpOpU.
//
// The codes are BoolTest's, so an encoding reads $cop$$cmpcode as a
// BoolTest::mask and chooses the IA-64 relation (and operand order) itself.

// used for signed integral comparisons and fp comparisons
operand cmpOp()
%{
  match(Bool);

  format %{ "" %}
  interface(COND_INTER) %{
    equal(0x0, "eq");
    not_equal(0x4, "ne");
    less(0x3, "lt");
    greater_equal(0x7, "ge");
    less_equal(0x5, "le");
    greater(0x1, "gt");
    overflow(0x2, "overflow");
    no_overflow(0x6, "no_overflow");
  %}
%}

// used for unsigned integral comparisons
operand cmpOpU()
%{
  match(Bool);

  format %{ "" %}
  interface(COND_INTER) %{
    equal(0x0, "eq");
    not_equal(0x4, "ne");
    less(0x3, "ltu");
    greater_equal(0x7, "geu");
    less_equal(0x5, "leu");
    greater(0x1, "gtu");
    overflow(0x2, "overflow");
    no_overflow(0x6, "no_overflow");
  %}
%}

// used for certain integral comparisons which can be
// converted to bxx instructions
operand cmpOpEqNe()
%{
  match(Bool);
  op_cost(0);
  predicate(n->as_Bool()->_test._test == BoolTest::ne ||
            n->as_Bool()->_test._test == BoolTest::eq);

  format %{ "" %}
  interface(COND_INTER) %{
    equal(0x0, "eq");
    not_equal(0x4, "ne");
    less(0x3, "lt");
    greater_equal(0x7, "ge");
    less_equal(0x5, "le");
    greater(0x1, "gt");
    overflow(0x2, "overflow");
    no_overflow(0x6, "no_overflow");
  %}
%}

//----------OPERAND CLASSES----------------------------------------------------
// Operand Classes are groups of operands that are used as to simplify
// instruction definitions by not requiring the AD writer to specify
// separate instructions for every form of operand when the
// instruction accepts multiple operand types with the same basic
// encoding and format. The classic case of this is memory operands.

opclass memory(indirect, indOffset14);

// An int input: an int register or a long used as an int.
opclass iRegIorL2I(iRegI, iRegL2I);

//----------PIPELINE-----------------------------------------------------------
// Rules which define the behavior of the target architectures pipeline.
//
// No machine model yet (OptoScheduling is off): one pipeline class per
// broad kind of node, with fixed latencies. The Itanium 2 model -- bundles,
// dispersal to M0-M3/I0-I1/F0-F1/B0-B2, itanium2.md latencies -- is C2-4
// (C2-DESIGN.md section 11). Until then instruction_unit_size is the bundle,
// so Pipeline::requires_bundling() is false and C2 does not form bundles.

pipeline %{

attributes %{
  // Every node emits whole 16-byte bundles; a node may emit several.
  variable_size_instructions;
  max_instructions_per_bundle = 3;
  instruction_unit_size = 16;
  instruction_fetch_unit_size = 32;  // two bundles per cycle
  instruction_fetch_units = 1;

  // List of nop instructions
  nops( MachNop );
%}

//----------RESOURCES----------------------------------------------------------
// Resources are the functional units available to the machine

resources( M0, M1, M2, M3, I0, I1, F0, F1, B0, B1, B2,
           MEM = M0 | M1 | M2 | M3,
           INT = I0 | I1,
           FPU = F0 | F1,
           BR  = B0 | B1 | B2 );

//----------PIPELINE DESCRIPTION-----------------------------------------------
// Pipeline Description specifies the stages in the machine's pipeline

// Itanium 2's back end: register read, execute, detect, write-back.
pipe_desc(S0, S1, S2, S3, S4, S5);

//----------PIPELINE CLASSES---------------------------------------------------
// Pipeline Classes describe the stages in which input and output are
// referenced by the hardware pipeline.

pipe_class pipe_class_default()
%{
  single_instruction;
  fixed_latency(2);
%}

pipe_class pipe_class_empty()
%{
  single_instruction;
  fixed_latency(0);
%}

pipe_class ialu_reg_reg(iRegI dst, iRegI src1, iRegI src2)
%{
  single_instruction;
  dst  : S3(write);
  src1 : S2(read);
  src2 : S2(read);
  INT  : S2;
%}

pipe_class ialu_reg(iRegI dst, iRegI src)
%{
  single_instruction;
  dst  : S3(write);
  src  : S2(read);
  INT  : S2;
%}

pipe_class ialu_imm(iRegI dst)
%{
  single_instruction;
  dst  : S3(write);
  INT  : S2;
%}

pipe_class pipe_class_memory()
%{
  single_instruction;
  fixed_latency(4);
%}

pipe_class pipe_class_compare()
%{
  single_instruction;
  fixed_latency(2);
%}

pipe_class fp_default()
%{
  single_instruction;
  fixed_latency(4);
%}

pipe_class pipe_branch()
%{
  single_instruction;
  BR   : S1;
%}

pipe_class pipe_slow()
%{
  multiple_bundles;
  fixed_latency(16);
%}

pipe_class pipe_class_call()
%{
  multiple_bundles;
  fixed_latency(100);
%}

// Define the class for the Nop node.
define %{
   MachNop = pipe_class_empty;
%}

%}

//----------INSTRUCTIONS-------------------------------------------------------
//
// match      -- States which machine-independent subtree may be replaced
//               by this instruction.
// ins_cost   -- The estimated cost of this instruction is used by instruction
//               selection to identify a minimum cost tree of machine
//               instructions that matches a tree of machine-independent
//               instructions.
// format     -- A string providing the disassembly for this instruction.
//               The value of an instruction's operand may be inserted
//               by referring to it with a '$' prefix.
// opcode     -- Three instruction opcodes may be provided.  These are referred
//               to within an encode class as $primary, $secondary, and $tertiary
//               rrspectively.  The primary opcode is commonly used to
//               indicate the type of machine instruction, while secondary
//               and tertiary are often used for prefix options or addressing
//               modes.
// ins_encode -- A list of encode classes with parameters. The encode class
//               name must have been defined in an 'enc_class' specification
//               in the encode section of the architecture description.
//
// Each node emits whole bundles, so size() is in multiples of 16 bytes.

// ============================================================================
// Constants

instruct loadConI(iRegI dst, immI src)
%{
  match(Set dst src);

  ins_cost(ALU_COST);
  format %{ "mov  $dst, $src\t# int, @loadConI" %}

  ins_encode %{
    __ mov_immediate($dst$$Register, (int64_t)$src$$constant);
  %}

  ins_pipe(ialu_imm);
%}

instruct loadConL(iRegL dst, immL src)
%{
  match(Set dst src);

  ins_cost(ALU_COST);
  format %{ "mov  $dst, $src\t# long, @loadConL" %}

  ins_encode %{
    __ mov_immediate($dst$$Register, (int64_t)$src$$constant);
  %}

  ins_pipe(ialu_imm);
%}

instruct loadConP(iRegPNoSp dst, immP con)
%{
  match(Set dst con);

  ins_cost(ALU_COST);
  format %{ "movl  $dst, $con\t# ptr, @loadConP" %}

  ins_encode %{
    Register dst_reg = $dst$$Register;
    address con = (address)$con$$constant;
    relocInfo::relocType rtype = $con->constant_reloc();
    if (rtype == relocInfo::oop_type) {
      __ movoop(dst_reg, (jobject)con);
    } else if (rtype == relocInfo::metadata_type) {
      __ mov_metadata(dst_reg, (Metadata*)con);
    } else {
      assert(rtype == relocInfo::none, "unexpected reloc type");
      __ mov_immediate(dst_reg, (int64_t)con);
    }
  %}

  ins_pipe(ialu_imm);
%}

instruct loadConP0(iRegPNoSp dst, immP0 con)
%{
  match(Set dst con);

  ins_cost(ALU_COST);
  format %{ "mov  $dst, r0\t# null pointer, @loadConP0" %}

  ins_encode %{
    __ mov($dst$$Register, zr);
  %}

  ins_pipe(ialu_imm);
%}

instruct loadConP1(iRegPNoSp dst, immP_1 con)
%{
  match(Set dst con);

  ins_cost(ALU_COST);
  format %{ "adds  $dst, 1, r0\t# ptr, @loadConP1" %}

  ins_encode %{
    __ mov_immediate($dst$$Register, 1);
  %}

  ins_pipe(ialu_imm);
%}

// A narrow klass constant: the encoded value in a movl, with a metadata
// relocation naming the Klass* (whose value comes from the nmethod's metadata
// table; metadata_Relocation::pd_fix_value never rewrites the immediate).
instruct loadConNKlass(iRegN dst, immNKlass con)
%{
  match(Set dst con);

  ins_cost(ALU_COST);
  format %{ "movl  $dst, $con\t# compressed klass ptr, @loadConNKlass" %}

  ins_encode %{
    __ set_narrow_klass($dst$$Register, (Klass*)$con$$constant);
  %}

  ins_pipe(ialu_imm);
%}

// FP constants: the bits in a GR, then setf (C2-DESIGN.md section 6).
instruct loadConF(fRegF dst, immF con)
%{
  match(Set dst con);

  ins_cost(XFER_COST);
  format %{ "movl t1, $con ; setf.s $dst, t1\t# float, @loadConF" %}

  ins_encode %{
    __ mov_immediate(t1, (int64_t)(juint)jint_cast($con$$constant));
    __ setf_s($dst$$FloatRegister, t1);
  %}

  ins_pipe(fp_default);
%}

instruct loadConF0(fRegF dst, immF0 con)
%{
  match(Set dst con);

  ins_cost(ALU_COST);
  format %{ "mov  $dst, f0\t# float 0.0, @loadConF0" %}

  ins_encode %{
    __ fmov($dst$$FloatRegister, f0);
  %}

  ins_pipe(fp_default);
%}

instruct loadConD(fRegD dst, immD con)
%{
  match(Set dst con);

  ins_cost(XFER_COST);
  format %{ "movl t1, $con ; setf.d $dst, t1\t# double, @loadConD" %}

  ins_encode %{
    __ mov_immediate(t1, jlong_cast($con$$constant));
    __ setf_d($dst$$FloatRegister, t1);
  %}

  ins_pipe(fp_default);
%}

instruct loadConD0(fRegD dst, immD0 con)
%{
  match(Set dst con);

  ins_cost(ALU_COST);
  format %{ "mov  $dst, f0\t# double 0.0, @loadConD0" %}

  ins_encode %{
    __ fmov($dst$$FloatRegister, f0);
  %}

  ins_pipe(fp_default);
%}

// ============================================================================
// Integer arithmetic
//
// Ints are lazy (C2-DESIGN.md section 3): only the low 32 bits of an int
// register are defined, so 32-bit add, subtract, logical ops and left shifts
// are the 64-bit instructions. Consumers that read 64 bits extend.

instruct addI_reg_reg(iRegI dst, iRegIorL2I src1, iRegIorL2I src2)
%{
  match(Set dst (AddI src1 src2));

  ins_cost(ALU_COST);
  format %{ "add  $dst, $src1, $src2\t# int, @addI_reg_reg" %}

  ins_encode %{
    __ add($dst$$Register, $src1$$Register, $src2$$Register);
  %}

  ins_pipe(ialu_reg_reg);
%}

instruct addI_reg_imm(iRegI dst, iRegIorL2I src1, immI14 src2)
%{
  match(Set dst (AddI src1 src2));

  ins_cost(ALU_COST);
  format %{ "adds  $dst, $src2, $src1\t# int, @addI_reg_imm" %}

  ins_encode %{
    __ adds($dst$$Register, (int64_t)$src2$$constant, $src1$$Register);
  %}

  ins_pipe(ialu_reg);
%}

instruct addL_reg_reg(iRegL dst, iRegL src1, iRegL src2)
%{
  match(Set dst (AddL src1 src2));

  ins_cost(ALU_COST);
  format %{ "add  $dst, $src1, $src2\t# long, @addL_reg_reg" %}

  ins_encode %{
    __ add($dst$$Register, $src1$$Register, $src2$$Register);
  %}

  ins_pipe(ialu_reg_reg);
%}

instruct addL_reg_imm(iRegL dst, iRegL src1, immL14 src2)
%{
  match(Set dst (AddL src1 src2));

  ins_cost(ALU_COST);
  format %{ "adds  $dst, $src2, $src1\t# long, @addL_reg_imm" %}

  ins_encode %{
    __ adds($dst$$Register, (int64_t)$src2$$constant, $src1$$Register);
  %}

  ins_pipe(ialu_reg);
%}

instruct addP_reg_reg(iRegPNoSp dst, iRegP src1, iRegL src2)
%{
  match(Set dst (AddP src1 src2));

  ins_cost(ALU_COST);
  format %{ "add  $dst, $src1, $src2\t# ptr, @addP_reg_reg" %}

  ins_encode %{
    __ add($dst$$Register, $src1$$Register, $src2$$Register);
  %}

  ins_pipe(ialu_reg_reg);
%}

instruct addP_reg_imm(iRegPNoSp dst, iRegP src1, immL14 src2)
%{
  match(Set dst (AddP src1 src2));

  ins_cost(ALU_COST);
  format %{ "adds  $dst, $src2, $src1\t# ptr, @addP_reg_imm" %}

  ins_encode %{
    __ adds($dst$$Register, (int64_t)$src2$$constant, $src1$$Register);
  %}

  ins_pipe(ialu_reg);
%}

// The array-element address: shladd dst = index << scale, base, for an
// element size of 2-16 bytes (shladd counts 1-4). The index is a long.
instruct addP_reg_lshl(iRegPNoSp dst, iRegP base, iRegL index, immI_1_4 scale)
%{
  match(Set dst (AddP base (LShiftL index scale)));

  ins_cost(ALU_COST);
  format %{ "shladd  $dst, $index, $scale, $base\t# ptr, @addP_reg_lshl" %}

  ins_encode %{
    __ shladd($dst$$Register, $index$$Register, (int)$scale$$constant, $base$$Register);
  %}

  ins_pipe(ialu_reg_reg);
%}

// As above with the int index's conversion folded in: sxt4 then shladd.
instruct addP_reg_convI2L_lshl(iRegPNoSp dst, iRegP base, iRegIorL2I index, immI_1_4 scale)
%{
  match(Set dst (AddP base (LShiftL (ConvI2L index) scale)));

  ins_cost(2 * ALU_COST);
  format %{ "sxt4 t1, $index ; shladd  $dst, t1, $scale, $base\t# ptr, @addP_reg_convI2L_lshl" %}

  ins_encode %{
    __ sxt4(t1, $index$$Register);
    __ shladd($dst$$Register, t1, (int)$scale$$constant, $base$$Register);
  %}

  ins_pipe(ialu_reg_reg);
%}

instruct subI_reg_reg(iRegI dst, iRegIorL2I src1, iRegIorL2I src2)
%{
  match(Set dst (SubI src1 src2));

  ins_cost(ALU_COST);
  format %{ "sub  $dst, $src1, $src2\t# int, @subI_reg_reg" %}

  ins_encode %{
    __ sub($dst$$Register, $src1$$Register, $src2$$Register);
  %}

  ins_pipe(ialu_reg_reg);
%}

// imm8 - reg (A3)
instruct subI_imm_reg(iRegI dst, immI8 src1, iRegIorL2I src2)
%{
  match(Set dst (SubI src1 src2));

  ins_cost(ALU_COST);
  format %{ "sub  $dst, $src1, $src2\t# int, @subI_imm_reg" %}

  ins_encode %{
    __ Assembler::sub_imm($dst$$Register, (int64_t)$src1$$constant, $src2$$Register);
  %}

  ins_pipe(ialu_reg);
%}

instruct subL_reg_reg(iRegL dst, iRegL src1, iRegL src2)
%{
  match(Set dst (SubL src1 src2));

  ins_cost(ALU_COST);
  format %{ "sub  $dst, $src1, $src2\t# long, @subL_reg_reg" %}

  ins_encode %{
    __ sub($dst$$Register, $src1$$Register, $src2$$Register);
  %}

  ins_pipe(ialu_reg_reg);
%}

instruct subL_imm_reg(iRegL dst, immL8 src1, iRegL src2)
%{
  match(Set dst (SubL src1 src2));

  ins_cost(ALU_COST);
  format %{ "sub  $dst, $src1, $src2\t# long, @subL_imm_reg" %}

  ins_encode %{
    __ Assembler::sub_imm($dst$$Register, (int64_t)$src1$$constant, $src2$$Register);
  %}

  ins_pipe(ialu_reg);
%}

// Multiply through the FP unit: setf.sig x2, xma.l, getf.sig. The low 32
// bits of a 64-bit product are the int product.
instruct mulI(iRegI dst, iRegIorL2I src1, iRegIorL2I src2)
%{
  match(Set dst (MulI src1 src2));

  ins_cost(IMUL_COST);
  format %{ "mul  $dst, $src1, $src2\t# int, @mulI" %}

  ins_encode %{
    __ mul($dst$$Register, $src1$$Register, $src2$$Register);
  %}

  ins_pipe(pipe_slow);
%}

instruct mulL(iRegL dst, iRegL src1, iRegL src2)
%{
  match(Set dst (MulL src1 src2));

  ins_cost(IMUL_COST);
  format %{ "mul  $dst, $src1, $src2\t# long, @mulL" %}

  ins_encode %{
    __ mul($dst$$Register, $src1$$Register, $src2$$Register);
  %}

  ins_pipe(pipe_slow);
%}

// Divide and remainder: java_div_rem, GCC's divide sequence through the FP
// unit (f2-f6, p6, t1). The divisor is non-zero: C2 tests it beforehand.
// Int operands are sign-extended into t2/t3 first (lazy ints).
instruct divI(iRegI dst, iRegIorL2I src1, iRegIorL2I src2)
%{
  match(Set dst (DivI src1 src2));

  ins_cost(IDIV_COST);
  format %{ "div  $dst, $src1, $src2\t# int, @divI" %}

  ins_encode %{
    __ sxt4(t2, $src1$$Register);
    __ sxt4(t3, $src2$$Register);
    __ java_div_rem($dst$$Register, t2, t3, false);
  %}

  ins_pipe(pipe_slow);
%}

instruct modI(iRegI dst, iRegIorL2I src1, iRegIorL2I src2)
%{
  match(Set dst (ModI src1 src2));

  ins_cost(IDIV_COST);
  format %{ "rem  $dst, $src1, $src2\t# int, @modI" %}

  ins_encode %{
    __ sxt4(t2, $src1$$Register);
    __ sxt4(t3, $src2$$Register);
    __ java_div_rem($dst$$Register, t2, t3, true);
  %}

  ins_pipe(pipe_slow);
%}

instruct divL(iRegL dst, iRegL src1, iRegL src2)
%{
  match(Set dst (DivL src1 src2));

  ins_cost(IDIV_COST);
  format %{ "div  $dst, $src1, $src2\t# long, @divL" %}

  ins_encode %{
    __ java_div_rem($dst$$Register, $src1$$Register, $src2$$Register, false);
  %}

  ins_pipe(pipe_slow);
%}

instruct modL(iRegL dst, iRegL src1, iRegL src2)
%{
  match(Set dst (ModL src1 src2));

  ins_cost(IDIV_COST);
  format %{ "rem  $dst, $src1, $src2\t# long, @modL" %}

  ins_encode %{
    __ mov(t2, $src1$$Register);
    __ mov(t3, $src2$$Register);
    __ java_div_rem($dst$$Register, t2, t3, true);
  %}

  ins_pipe(pipe_slow);
%}

