    __ extr_u($dst$$Register, $src1$$Register, s, 32 - s);
  %}

  ins_pipe(ialu_reg);
%}

instruct lShiftL_reg_reg(iRegL dst, iRegL src1, iRegIorL2I src2)
%{
  match(Set dst (LShiftL src1 src2));

  ins_cost(2 * ALU_COST);
