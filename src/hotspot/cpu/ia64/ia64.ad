// ============================================================================
// Memory barriers (C2-DESIGN.md section 9)
//
// Bring-up form: every ordering barrier is a full mf. Folding acquire and
// release barriers into ld.acq / st.rel comes with the ordered access forms.

instruct membar_acquire()
%{
  match(MemBarAcquire);
  match(LoadFence);
  ins_cost(VOLATILE_REF_COST);

  format %{ "mf\t# membar_acquire" %}

  ins_encode %{
    __ mf();
  %}

  ins_pipe(pipe_slow);
%}

instruct membar_release()
%{
  match(MemBarRelease);
  match(StoreFence);
  ins_cost(VOLATILE_REF_COST);

  format %{ "mf\t# membar_release" %}

  ins_encode %{
    __ mf();
  %}

  ins_pipe(pipe_slow);
%}

instruct membar_storestore()
%{
  match(MemBarStoreStore);
  match(StoreStoreFence);
  ins_cost(VOLATILE_REF_COST);

  format %{ "mf\t# membar_storestore" %}

  ins_encode %{
    __ mf();
  %}

  ins_pipe(pipe_slow);
%}

instruct membar_volatile()
%{
  match(MemBarVolatile);
  ins_cost(VOLATILE_REF_COST);

  format %{ "mf\t# membar_volatile" %}

  ins_encode %{
    __ mf();
  %}

  ins_pipe(pipe_slow);
%}

// The locking primitives order themselves: lightweight locking's cmpxchg is
// .acq when locking and the unlocking store is a release.
instruct membar_acquire_lock()
%{
  match(MemBarAcquireLock);
  ins_cost(0);

  size(0);
  format %{ "#@membar_acquire_lock (elided)" %}
  ins_encode(/* empty encoding */);
  ins_pipe(pipe_class_empty);
%}

instruct membar_release_lock()
%{
  match(MemBarReleaseLock);
  ins_cost(0);

  size(0);
  format %{ "#@membar_release_lock (elided)" %}
  ins_encode(/* empty encoding */);
  ins_pipe(pipe_class_empty);
%}

instruct unnecessary_membar_cpuorder()
%{
  match(MemBarCPUOrder);
  ins_cost(0);

  size(0);
  format %{ "#@membar_cpuorder (elided)" %}
  ins_encode(/* empty encoding */);
  ins_pipe(pipe_class_empty);
%}

// ============================================================================
// The current thread: Rthread (r5) holds it throughout.

instruct tlsLoadP(javaThread_RegP dst)
%{
  match(Set dst (ThreadLocal));

  ins_cost(0);

  format %{ " -- \t// $dst=Thread::current(), empty, @tlsLoadP" %}

  size(0);

  ins_encode( /*empty*/ );

  ins_pipe(pipe_class_empty);
%}

// ============================================================================
// Safepoint poll: a load from the thread's polling page, which faults when
// armed (C2-DESIGN.md section 8). The load is a bundle of its own, with the
// poll relocation; the handler blob resumes at the next bundle.

instruct safePoint(iRegP poll)
%{
  match(SafePoint poll);

  ins_cost(2 * LOAD_COST);
  format %{ "ld8 t1, [$poll]\t# Safepoint: poll for GC, @safePoint" %}

  ins_encode %{
    __ read_polling_page($poll$$Register);
  %}

  ins_pipe(pipe_class_memory);
%}

// ============================================================================
// Calls (C2-DESIGN.md section 7)

instruct CallStaticJavaDirect(method meth)
%{
  match(CallStaticJava);

  effect(USE meth);

  ins_cost(BRANCH_COST);

  format %{ "CALL,static $meth\t# @CallStaticJavaDirect" %}

  ins_encode(ia64_enc_java_static_call(meth));

  ins_pipe(pipe_class_call);
%}

instruct CallDynamicJavaDirect(method meth)
%{
  match(CallDynamicJava);

  effect(USE meth);

  ins_cost(BRANCH_COST + ALU_COST);

  format %{ "CALL,dynamic $meth\t# @CallDynamicJavaDirect" %}

  ins_encode(ia64_enc_java_dynamic_call(meth));

  ins_pipe(pipe_class_call);
%}

instruct CallRuntimeDirect(method meth)
%{
  match(CallRuntime);

  effect(USE meth);

  ins_cost(BRANCH_COST);

  format %{ "CALL, runtime $meth\t# @CallRuntimeDirect" %}

  ins_encode(ia64_enc_java_to_runtime(meth));

  ins_pipe(pipe_class_call);
%}

instruct CallLeafDirect(method meth)
%{
  match(CallLeaf);

  effect(USE meth);

  ins_cost(BRANCH_COST);

  format %{ "CALL, runtime leaf $meth\t# @CallLeafDirect" %}

  ins_encode(ia64_enc_java_to_runtime(meth));

  ins_pipe(pipe_class_call);
%}

instruct CallLeafNoFPDirect(method meth)
%{
  match(CallLeafNoFP);

  effect(USE meth);

  ins_cost(BRANCH_COST);

  format %{ "CALL, runtime leaf nofp $meth\t# @CallLeafNoFPDirect" %}

  ins_encode(ia64_enc_java_to_runtime(meth));

  ins_pipe(pipe_class_call);
%}

// Tail Call; Jump from runtime stub to Java code.
// Also known as an 'interprocedural jump'.
// Target of jump will eventually return to caller.
// TailJump below removes the return address.
// The frame is already gone (MachEpilog), so b0 holds the caller's return
// address; the Method* travels in Rmethod.
instruct TailCalljmpInd(iRegPNoSp jump_target, inline_cache_RegP method_ptr)
%{
  match(TailCall jump_target method_ptr);

  ins_cost(BRANCH_COST);

  format %{ "jr  $jump_target\t# $method_ptr holds method, @TailCalljmpInd" %}

  ins_encode %{
    __ jr($jump_target$$Register);
  %}

  ins_pipe(pipe_class_call);
%}

// The rethrow stub's exit to the exception handler it found: the exception
// oop in r8, the return address (the throwing pc in the caller) moved from b0
// to Rexception_pc, as the handler expects.
instruct TailjmpInd(iRegPNoSp jump_target, iRegP_R8 ex_oop)
%{
  match(TailJump jump_target ex_oop);

  ins_cost(ALU_COST + BRANCH_COST);

  format %{ "mov r28 = b0 ; jr  $jump_target\t# $ex_oop holds exception oop, @TailjmpInd" %}

  ins_encode %{
    __ mov_from_br(Rexception_pc, breturn);
    __ jr($jump_target$$Register);
  %}

  ins_pipe(pipe_class_call);
%}

// Forward exception: the frame is gone and b0 holds the return address, as
// StubRoutines::forward_exception_entry expects.
instruct ForwardExceptionjmp()
%{
  match(ForwardException);

  ins_cost(BRANCH_COST);

  format %{ "far_jump forward_exception_stub\t# @ForwardException" %}

  ins_encode %{
    __ far_jump(StubRoutines::forward_exception_entry());
  %}

  ins_pipe(pipe_class_call);
%}

// Create exception oop: created by stack-crawling runtime code.
// Created exception is now available to this handler, and is setup
// just prior to jumping to this handler. No code emitted.
instruct CreateException(iRegP_R8 ex_oop)
%{
  match(Set ex_oop (CreateEx));

  ins_cost(0);
  format %{ " -- \t// exception oop; no code emitted, @CreateException" %}

  size(0);

  ins_encode( /*empty*/ );

  ins_pipe(pipe_class_empty);
%}

// Rethrow exception: The exception oop will come in the first
// argument position. Then JUMP (not call) to the rethrow stub code.
instruct RethrowException()
%{
  match(Rethrow);

  ins_cost(BRANCH_COST);

  format %{ "far_jump rethrow_stub\t# @RethrowException" %}

  ins_encode %{
    __ far_jump(OptoRuntime::rethrow_stub());
  %}

  ins_pipe(pipe_class_call);
%}

// Return Instruction
// epilog node loads ret address into b0 as part of frame pop
instruct Ret()
%{
  match(Return);

  ins_cost(BRANCH_COST);
  format %{ "br.ret b0\t# @Ret" %}

  ins_encode %{
    __ ret();
  %}

  ins_pipe(pipe_branch);
%}

// Die now.
instruct ShouldNotReachHere()
%{
  match(Halt);

  ins_cost(BRANCH_COST);
  format %{ "ShouldNotReachHere" %}

  ins_encode %{
    if (is_reachable()) {
      const char* str = __ code_string(_halt_reason);
      __ stop(str);
    }
  %}

  ins_pipe(pipe_slow);
%}


// ============================================================================
// Locking (lightweight only). The result is RFLAGS: p10 = success.

instruct cmpFastLockLightweight(rFlagsReg cr, iRegP object, iRegP box,
                                iRegPNoSp tmp1, iRegPNoSp tmp2, iRegPNoSp tmp3)
%{
  predicate(LockingMode == LM_LIGHTWEIGHT);
  match(Set cr (FastLock object box));
  effect(TEMP tmp1, TEMP tmp2, TEMP tmp3);

  ins_cost(10 * DEFAULT_COST);
  format %{ "fastlock $object, $box\t! kills $tmp1, $tmp2, $tmp3, @cmpFastLockLightweight" %}

  ins_encode %{
    __ fast_lock_lightweight($object$$Register, $box$$Register,
                             $tmp1$$Register, $tmp2$$Register, $tmp3$$Register);
  %}

  ins_pipe(pipe_slow);
%}

instruct cmpFastUnlockLightweight(rFlagsReg cr, iRegP object, iRegP box,
                                  iRegPNoSp tmp1, iRegPNoSp tmp2, iRegPNoSp tmp3)
%{
  predicate(LockingMode == LM_LIGHTWEIGHT);
  match(Set cr (FastUnlock object box));
  effect(TEMP tmp1, TEMP tmp2, TEMP tmp3);

  ins_cost(10 * DEFAULT_COST);
  format %{ "fastunlock $object, $box\t! kills $tmp1, $tmp2, $tmp3, @cmpFastUnlockLightweight" %}

  ins_encode %{
    __ fast_unlock_lightweight($object$$Register, $box$$Register,
                               $tmp1$$Register, $tmp2$$Register, $tmp3$$Register);
  %}

  ins_pipe(pipe_slow);
%}

// A branch on RFLAGS (p10 = eq, p11 = ne).
instruct cmpFlag_branch(cmpOpEqNe cmp, rFlagsReg cr, label lbl)
%{
  match(If cmp cr);
  effect(USE lbl);

  ins_cost(BRANCH_COST);
  format %{ "(p10/p11) br $lbl\t# RFLAGS $cmp, @cmpFlag_branch" %}

  ins_encode %{
    __ br_cond(*($lbl$$label), ($cmp$$cmpcode == BoolTest::eq) ? p10 : p11);
  %}

  ins_pipe(pipe_branch);
%}

// ============================================================================
// Atomic operations (C2-DESIGN.md section 9)
//
// cmpxchg compares ar.ccv with the zero-extended memory value, so an int's
// expected value is zero-extended first (lazy ints). The .acq form; the
// barriers C2 places around these nodes are full mfs.

instruct compareAndSwapI(iRegI res, indirect mem, iRegIorL2I oldval, iRegIorL2I newval)
%{
  match(Set res (CompareAndSwapI mem (Binary oldval newval)));
  match(Set res (WeakCompareAndSwapI mem (Binary oldval newval)));

  ins_cost(VOLATILE_REF_COST);
  format %{ "cmpxchg4.acq $mem, $oldval, $newval => $res\t# (int) @compareAndSwapI" %}

  ins_encode %{
    __ zxt4(t1, $oldval$$Register);
    __ mov_to_ar_ccv(t1);
    __ cmpxchg4_acq(t2, $mem$$Register, $newval$$Register);
    __ cmp_eq(ptmp0, ptmp1, t2, t1);
    __ mov($res$$Register, zr);
    __ adds($res$$Register, 1, zr, ptmp0);
  %}

  ins_pipe(pipe_slow);
%}

instruct compareAndSwapL(iRegI res, indirect mem, iRegL oldval, iRegL newval)
%{
  match(Set res (CompareAndSwapL mem (Binary oldval newval)));
  match(Set res (WeakCompareAndSwapL mem (Binary oldval newval)));

  ins_cost(VOLATILE_REF_COST);
  format %{ "cmpxchg8.acq $mem, $oldval, $newval => $res\t# (long) @compareAndSwapL" %}

  ins_encode %{
    __ mov_to_ar_ccv($oldval$$Register);
    __ cmpxchg8_acq(t2, $mem$$Register, $newval$$Register);
    __ cmp_eq(ptmp0, ptmp1, t2, $oldval$$Register);
    __ mov($res$$Register, zr);
    __ adds($res$$Register, 1, zr, ptmp0);
  %}

  ins_pipe(pipe_slow);
%}

instruct compareAndSwapP(iRegI res, indirect mem, iRegP oldval, iRegP newval)
%{
  predicate(n->as_LoadStore()->barrier_data() == 0);
  match(Set res (CompareAndSwapP mem (Binary oldval newval)));
  match(Set res (WeakCompareAndSwapP mem (Binary oldval newval)));

  ins_cost(VOLATILE_REF_COST);
  format %{ "cmpxchg8.acq $mem, $oldval, $newval => $res\t# (ptr) @compareAndSwapP" %}

  ins_encode %{
    __ mov_to_ar_ccv($oldval$$Register);
    __ cmpxchg8_acq(t2, $mem$$Register, $newval$$Register);
    __ cmp_eq(ptmp0, ptmp1, t2, $oldval$$Register);
    __ mov($res$$Register, zr);
    __ adds($res$$Register, 1, zr, ptmp0);
  %}

  ins_pipe(pipe_slow);
%}

instruct compareAndExchangeI(iRegI res, indirect mem, iRegIorL2I oldval, iRegIorL2I newval)
%{
  match(Set res (CompareAndExchangeI mem (Binary oldval newval)));

  ins_cost(VOLATILE_REF_COST);
  format %{ "cmpxchg4.acq $res = $mem, $oldval, $newval\t# (int) @compareAndExchangeI" %}

  ins_encode %{
    __ zxt4(t1, $oldval$$Register);
    __ mov_to_ar_ccv(t1);
    __ cmpxchg4_acq($res$$Register, $mem$$Register, $newval$$Register);
  %}

  ins_pipe(pipe_slow);
%}

instruct compareAndExchangeL(iRegL res, indirect mem, iRegL oldval, iRegL newval)
%{
  match(Set res (CompareAndExchangeL mem (Binary oldval newval)));

  ins_cost(VOLATILE_REF_COST);
  format %{ "cmpxchg8.acq $res = $mem, $oldval, $newval\t# (long) @compareAndExchangeL" %}

  ins_encode %{
    __ mov_to_ar_ccv($oldval$$Register);
    __ cmpxchg8_acq($res$$Register, $mem$$Register, $newval$$Register);
  %}

  ins_pipe(pipe_slow);
%}

instruct compareAndExchangeP(iRegPNoSp res, indirect mem, iRegP oldval, iRegP newval)
%{
  predicate(n->as_LoadStore()->barrier_data() == 0);
  match(Set res (CompareAndExchangeP mem (Binary oldval newval)));

  ins_cost(VOLATILE_REF_COST);
  format %{ "cmpxchg8.acq $res = $mem, $oldval, $newval\t# (ptr) @compareAndExchangeP" %}

  ins_encode %{
    __ mov_to_ar_ccv($oldval$$Register);
    __ cmpxchg8_acq($res$$Register, $mem$$Register, $newval$$Register);
  %}

  ins_pipe(pipe_slow);
%}

// xchg has acquire semantics.
instruct get_and_setI(indirect mem, iRegIorL2I newv, iRegI prev)
%{
  match(Set prev (GetAndSetI mem newv));

  ins_cost(VOLATILE_REF_COST);
  format %{ "xchg4 $prev = $mem, $newv\t# (int) @get_and_setI" %}

  ins_encode %{
    __ xchg4($prev$$Register, $mem$$Register, $newv$$Register);
  %}

  ins_pipe(pipe_slow);
%}

instruct get_and_setL(indirect mem, iRegL newv, iRegL prev)
%{
  match(Set prev (GetAndSetL mem newv));

  ins_cost(VOLATILE_REF_COST);
  format %{ "xchg8 $prev = $mem, $newv\t# (long) @get_and_setL" %}

  ins_encode %{
    __ xchg8($prev$$Register, $mem$$Register, $newv$$Register);
  %}

  ins_pipe(pipe_slow);
%}

instruct get_and_setP(indirect mem, iRegP newv, iRegPNoSp prev)
%{
  predicate(n->as_LoadStore()->barrier_data() == 0);
  match(Set prev (GetAndSetP mem newv));

  ins_cost(VOLATILE_REF_COST);
  format %{ "xchg8 $prev = $mem, $newv\t# (ptr) @get_and_setP" %}

  ins_encode %{
    __ xchg8($prev$$Register, $mem$$Register, $newv$$Register);
  %}

  ins_pipe(pipe_slow);
%}

// get-and-add as a CAS loop (fetchadd takes only +-1, 4, 8, 16). ld4
// zero-extends, as cmpxchg4 compares.
instruct get_and_addI(indirect mem, iRegI newval, iRegIorL2I incr)
%{
  match(Set newval (GetAndAddI mem incr));

  ins_cost(2 * VOLATILE_REF_COST);
  format %{ "get_and_addI $newval, [$mem], $incr\t# @get_and_addI" %}

  ins_encode %{
    Label retry;
    __ bind(retry);
    __ Assembler::ld4(t1, $mem$$Register);
    __ add(t3, t1, $incr$$Register);
    __ mov_to_ar_ccv(t1);
    __ cmpxchg4_acq(t2, $mem$$Register, t3);
    __ bne(t2, t1, retry);
    __ mov($newval$$Register, t1);
  %}

  ins_pipe(pipe_slow);
%}

instruct get_and_addL(indirect mem, iRegL newval, iRegL incr)
%{
  match(Set newval (GetAndAddL mem incr));

  ins_cost(2 * VOLATILE_REF_COST);
  format %{ "get_and_addL $newval, [$mem], $incr\t# @get_and_addL" %}

  ins_encode %{
    Label retry;
    __ bind(retry);
    __ Assembler::ld8(t1, $mem$$Register);
    __ add(t3, t1, $incr$$Register);
    __ mov_to_ar_ccv(t1);
    __ cmpxchg8_acq(t2, $mem$$Register, t3);
    __ bne(t2, t1, retry);
    __ mov($newval$$Register, t1);
  %}

  ins_pipe(pipe_slow);
%}

// ============================================================================
// Subtype check slow path: result is zero on a hit, non-zero on a miss.

instruct partialSubtypeCheck(iRegPNoSp result, iRegP sub, iRegP super, iRegPNoSp tmp1, iRegPNoSp tmp2)
%{
  match(Set result (PartialSubtypeCheck sub super));
  effect(TEMP tmp1, TEMP tmp2);

  ins_cost(11 * DEFAULT_COST);
  format %{ "partialSubtypeCheck $result, $sub, $super\t# @partialSubtypeCheck" %}

  ins_encode %{
    Label miss, done;
    __ check_klass_subtype_slow_path($sub$$Register, $super$$Register, $tmp1$$Register, $tmp2$$Register,
                                     nullptr, &miss);
    __ mov($result$$Register, zr);
    __ j(done);
    __ bind(miss);
    __ mov_immediate($result$$Register, 1);
    __ bind(done);
  %}

  ins_pipe(pipe_slow);
%}

// ============================================================================
// Clearing a block of words: base is 8-byte aligned, cnt counts words.

instruct clearArray_reg_reg(iRegL_R20 cnt, iRegP_R21 base, Universe dummy)
%{
  match(Set dummy (ClearArray cnt base));
  effect(USE_KILL cnt, USE_KILL base);

  ins_cost(4 * DEFAULT_COST);
  format %{ "ClearArray $cnt, $base\t# @clearArray_reg_reg" %}

  ins_encode %{
    Label loop, done;
    __ beqz($cnt$$Register, done);
    __ bind(loop);
    __ st8_inc($base$$Register, zr, wordSize);
    __ adds($cnt$$Register, -1, $cnt$$Register);
    __ bnez($cnt$$Register, loop);
    __ bind(done);
  %}

  ins_pipe(pipe_slow);
%}

//----------PEEPHOLE RULES-----------------------------------------------------
// These must follow all instruction definitions as they use the names
// defined in the instructions definitions.

