// Shifts
//
// IA-64 shifts by the whole register: counts of 64 or more give 0 (or the
// sign), so a variable count is masked to Java's 5 or 6 bits first. An int
// left shift is the 64-bit shift (the upper half is undefined anyway); right
// shifts extend the int first and shift the 64-bit value. Constant right
// shifts are extracts of the int's bits.

instruct lShiftI_reg_reg(iRegI dst, iRegIorL2I src1, iRegIorL2I src2)
%{
  match(Set dst (LShiftI src1 src2));

  ins_cost(2 * ALU_COST);
  format %{ "and t1, 31, $src2 ; shl  $dst, $src1, t1\t# int, @lShiftI_reg_reg" %}

  ins_encode %{
    __ Assembler::and_imm(t1, 31, $src2$$Register);
    __ shl($dst$$Register, $src1$$Register, t1);
  %}

  ins_pipe(ialu_reg_reg);
%}

instruct lShiftI_reg_imm(iRegI dst, iRegIorL2I src1, immI src2)
%{
  match(Set dst (LShiftI src1 src2));

  ins_cost(ALU_COST);
  format %{ "shl  $dst, $src1, ($src2 & 0x1f)\t# int, @lShiftI_reg_imm" %}

  ins_encode %{
    __ shl_imm($dst$$Register, $src1$$Register, (uint32_t)$src2$$constant & 0x1f);
  %}

  ins_pipe(ialu_reg);
%}

instruct rShiftI_reg_reg(iRegI dst, iRegIorL2I src1, iRegIorL2I src2)
%{
  match(Set dst (RShiftI src1 src2));

  ins_cost(3 * ALU_COST);
  format %{ "and t1, 31, $src2 ; sxt4 t2, $src1 ; shr  $dst, t2, t1\t# int, @rShiftI_reg_reg" %}

  ins_encode %{
    __ Assembler::and_imm(t1, 31, $src2$$Register);
    __ sxt4(t2, $src1$$Register);
    __ shr($dst$$Register, t2, t1);
  %}

  ins_pipe(ialu_reg_reg);
%}

instruct rShiftI_reg_imm(iRegI dst, iRegIorL2I src1, immI src2)
%{
  match(Set dst (RShiftI src1 src2));

  ins_cost(ALU_COST);
  format %{ "extr  $dst, $src1, ($src2 & 0x1f), 32 - ($src2 & 0x1f)\t# int, @rShiftI_reg_imm" %}

  ins_encode %{
    uint32_t s = (uint32_t)$src2$$constant & 0x1f;
    __ extr($dst$$Register, $src1$$Register, s, 32 - s);
  %}

  ins_pipe(ialu_reg);
%}

instruct urShiftI_reg_reg(iRegI dst, iRegIorL2I src1, iRegIorL2I src2)
%{
  match(Set dst (URShiftI src1 src2));

  ins_cost(3 * ALU_COST);
  format %{ "and t1, 31, $src2 ; zxt4 t2, $src1 ; shr.u  $dst, t2, t1\t# int, @urShiftI_reg_reg" %}

  ins_encode %{
    __ Assembler::and_imm(t1, 31, $src2$$Register);
    __ zxt4(t2, $src1$$Register);
    __ shru($dst$$Register, t2, t1);
  %}

  ins_pipe(ialu_reg_reg);
%}

instruct urShiftI_reg_imm(iRegI dst, iRegIorL2I src1, immI src2)
%{
  match(Set dst (URShiftI src1 src2));

  ins_cost(ALU_COST);
  format %{ "extr.u  $dst, $src1, ($src2 & 0x1f), 32 - ($src2 & 0x1f)\t# int, @urShiftI_reg_imm" %}

  ins_encode %{
