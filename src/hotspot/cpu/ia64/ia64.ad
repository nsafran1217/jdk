// IA-64 (Itanium) Architecture Description File
//
// C2-DESIGN.md is the design this implements (registers section 1, ints 3,
// conditions 4, addressing 5, constants 6, calls 7, frames 8, ordering 9,
// arithmetic 10, bundling 11, matcher 12); FRAME-DESIGN.md has the frame,
// register and calling-convention facts it builds on.
//
// The things that make IA-64 unusual for an .ad file:
//
// * Generated code uses only the static registers r0-r31 plus the outgoing
//   C-argument window out0-out7 (r32-r39) created by call_stub's single
//   `alloc` (FRAME-DESIGN.md 1). out0-out7 appear only in C-argument masks.
// * There is no displacement addressing: a load or store takes a bare
//   register, so base+offset costs an `adds` first.
// * Compares write predicate pairs and take their relation at compare time,
//   so branches and conditional moves match the whole If/Bool/Cmp pattern
//   (section 4).
// * Code comes in 16-byte bundles. Every node emits whole bundles; packing
//   within a node is the Assembler's (BUNDLING.md), and node sizes are
//   measured by scratch emission.

//----------REGISTER DEFINITION BLOCK------------------------------------------
// This information is used by the matcher and the register allocator to
// describe individual registers and classes of registers within the target
// architecture.

register %{
//----------Architecture Description Register Definitions----------------------
// General Registers
// "reg_def"  name ( register save type, C convention save type,
//                   ideal register type, encoding );
// Register Save Types:
//
// NS  = No-Save:       The register allocator assumes that these registers
//                      can be used without saving upon entry to the method, &
//                      that they do not need to be saved at call sites.
//
// SOC = Save-On-Call:  The register allocator assumes that these registers
//                      can be used without saving upon entry to the method,
//                      but that they must be saved at call sites.
//
// SOE = Save-On-Entry: The register allocator assumes that these registers
//                      must be saved before using them upon entry to the
//                      method, but they do not need to be saved at call
//                      sites.
//
// AS  = Always-Save:   The register allocator assumes that these registers
//                      must be saved before using them upon entry to the
//                      method, & that they must be saved at call sites.
//
// Ideal Register Type is used to determine how to save & restore a
// register.  Op_RegI will get spilled with LoadI/StoreI, Op_RegP will get
// spilled with LoadP/StoreP.  If the register supports both, use Op_RegI.
//
// The encoding number is the actual bit-pattern placed into the opcodes.
//
// 64-bit registers are defined as two 32-bit halves, the real lower register
// and a virtual upper half used by the register allocator.
//
// Compiled frames hold no callee-saved registers (FRAME-DESIGN.md 4.5, as
// riscv: deoptimizing a frame with callee-saved values is hard), so every
// allocatable register is save-on-call across Java calls. The C convention
// column is the psABI's: r4-r7 and f16-f31 (and f2-f5) are preserved by C
// callees, so r6/r7 and f16-f31 survive leaf calls.
//
// Allocatable: r6, r7, r8, r14-r31 (21) and f8-f31. Not allocatable: r0
// (zero), r1 (gp, scratch to MacroAssembler call sequences), r2/r3 and
// r9-r11 (MacroAssembler temporaries t0-t4), r4 (fp), r5 (Rthread), r12
// (sp), r13 (tp), out0-out7; f0/f1 (constants), f2-f5 (divide and sqrt
// temporaries), f6/f7 (MacroAssembler temporaries).

reg_def R0    (NS,  NS,  Op_RegI,  0, r0->as_VMReg()         );  // zr
reg_def R0_H  (NS,  NS,  Op_RegI,  0, r0->as_VMReg()->next() );
reg_def R1    (NS,  SOC, Op_RegI,  1, r1->as_VMReg()         );  // gp: scratch in generated code
reg_def R1_H  (NS,  SOC, Op_RegI,  1, r1->as_VMReg()->next() );
reg_def R2    (NS,  SOC, Op_RegI,  2, r2->as_VMReg()         );  // t0
reg_def R2_H  (NS,  SOC, Op_RegI,  2, r2->as_VMReg()->next() );
reg_def R3    (NS,  SOC, Op_RegI,  3, r3->as_VMReg()         );  // t1
reg_def R3_H  (NS,  SOC, Op_RegI,  3, r3->as_VMReg()->next() );
reg_def R4    (NS,  SOE, Op_RegI,  4, r4->as_VMReg()         );  // fp
reg_def R4_H  (NS,  SOE, Op_RegI,  4, r4->as_VMReg()->next() );
reg_def R5    (NS,  SOE, Op_RegI,  5, r5->as_VMReg()         );  // Rthread
reg_def R5_H  (NS,  SOE, Op_RegI,  5, r5->as_VMReg()->next() );
reg_def R6    (SOC, SOE, Op_RegI,  6, r6->as_VMReg()         );  // Rbcp in the interpreter; preserved by C callees
reg_def R6_H  (SOC, SOE, Op_RegI,  6, r6->as_VMReg()->next() );
reg_def R7    (SOC, SOE, Op_RegI,  7, r7->as_VMReg()         );  // Resp in the interpreter; preserved by C callees
reg_def R7_H  (SOC, SOE, Op_RegI,  7, r7->as_VMReg()->next() );
reg_def R8    (SOC, SOC, Op_RegI,  8, r8->as_VMReg()         );  // return value, Rexception
reg_def R8_H  (SOC, SOC, Op_RegI,  8, r8->as_VMReg()->next() );
reg_def R9    (NS,  SOC, Op_RegI,  9, r9->as_VMReg()         );  // t2
reg_def R9_H  (NS,  SOC, Op_RegI,  9, r9->as_VMReg()->next() );
reg_def R10   (NS,  SOC, Op_RegI, 10, r10->as_VMReg()         );  // t3
reg_def R10_H (NS,  SOC, Op_RegI, 10, r10->as_VMReg()->next() );
reg_def R11   (NS,  SOC, Op_RegI, 11, r11->as_VMReg()         );  // t4
reg_def R11_H (NS,  SOC, Op_RegI, 11, r11->as_VMReg()->next() );
reg_def R12   (NS,  NS,  Op_RegI, 12, r12->as_VMReg()         );  // sp
reg_def R12_H (NS,  NS,  Op_RegI, 12, r12->as_VMReg()->next() );
reg_def R13   (NS,  NS,  Op_RegI, 13, r13->as_VMReg()         );  // tp: ABI-reserved
reg_def R13_H (NS,  NS,  Op_RegI, 13, r13->as_VMReg()->next() );
reg_def R14   (SOC, SOC, Op_RegI, 14, r14->as_VMReg()         );  // Rmethod at calls
reg_def R14_H (SOC, SOC, Op_RegI, 14, r14->as_VMReg()->next() );
reg_def R15   (SOC, SOC, Op_RegI, 15, r15->as_VMReg()         );  // Rcpool (interpreter)
reg_def R15_H (SOC, SOC, Op_RegI, 15, r15->as_VMReg()->next() );
reg_def R16   (SOC, SOC, Op_RegI, 16, r16->as_VMReg()         );
reg_def R16_H (SOC, SOC, Op_RegI, 16, r16->as_VMReg()->next() );
reg_def R17   (SOC, SOC, Op_RegI, 17, r17->as_VMReg()         );
reg_def R17_H (SOC, SOC, Op_RegI, 17, r17->as_VMReg()->next() );
reg_def R18   (SOC, SOC, Op_RegI, 18, r18->as_VMReg()         );  // Rsender_sp (adapters)
reg_def R18_H (SOC, SOC, Op_RegI, 18, r18->as_VMReg()->next() );
reg_def R19   (SOC, SOC, Op_RegI, 19, r19->as_VMReg()         );  // Rlocals (interpreter)
reg_def R19_H (SOC, SOC, Op_RegI, 19, r19->as_VMReg()->next() );
reg_def R20   (SOC, SOC, Op_RegI, 20, r20->as_VMReg()         );  // j_rarg0
reg_def R20_H (SOC, SOC, Op_RegI, 20, r20->as_VMReg()->next() );
reg_def R21   (SOC, SOC, Op_RegI, 21, r21->as_VMReg()         );  // j_rarg1
reg_def R21_H (SOC, SOC, Op_RegI, 21, r21->as_VMReg()->next() );
reg_def R22   (SOC, SOC, Op_RegI, 22, r22->as_VMReg()         );  // j_rarg2
reg_def R22_H (SOC, SOC, Op_RegI, 22, r22->as_VMReg()->next() );
reg_def R23   (SOC, SOC, Op_RegI, 23, r23->as_VMReg()         );  // j_rarg3
reg_def R23_H (SOC, SOC, Op_RegI, 23, r23->as_VMReg()->next() );
reg_def R24   (SOC, SOC, Op_RegI, 24, r24->as_VMReg()         );  // j_rarg4
reg_def R24_H (SOC, SOC, Op_RegI, 24, r24->as_VMReg()->next() );
reg_def R25   (SOC, SOC, Op_RegI, 25, r25->as_VMReg()         );  // j_rarg5
reg_def R25_H (SOC, SOC, Op_RegI, 25, r25->as_VMReg()->next() );
reg_def R26   (SOC, SOC, Op_RegI, 26, r26->as_VMReg()         );  // j_rarg6
reg_def R26_H (SOC, SOC, Op_RegI, 26, r26->as_VMReg()->next() );
reg_def R27   (SOC, SOC, Op_RegI, 27, r27->as_VMReg()         );  // j_rarg7
reg_def R27_H (SOC, SOC, Op_RegI, 27, r27->as_VMReg()->next() );
reg_def R28   (SOC, SOC, Op_RegI, 28, r28->as_VMReg()         );  // Rexception_pc
reg_def R28_H (SOC, SOC, Op_RegI, 28, r28->as_VMReg()->next() );
reg_def R29   (SOC, SOC, Op_RegI, 29, r29->as_VMReg()         );
reg_def R29_H (SOC, SOC, Op_RegI, 29, r29->as_VMReg()->next() );
reg_def R30   (SOC, SOC, Op_RegI, 30, r30->as_VMReg()         );
reg_def R30_H (SOC, SOC, Op_RegI, 30, r30->as_VMReg()->next() );
reg_def R31   (SOC, SOC, Op_RegI, 31, r31->as_VMReg()         );
reg_def R31_H (SOC, SOC, Op_RegI, 31, r31->as_VMReg()->next() );
reg_def R32   (SOC, SOC, Op_RegI, 32, out0->as_VMReg()         );  // out0 = c_rarg0: C arguments only, never allocated
reg_def R32_H (SOC, SOC, Op_RegI, 32, out0->as_VMReg()->next() );
reg_def R33   (SOC, SOC, Op_RegI, 33, out1->as_VMReg()         );  // out1 = c_rarg1: C arguments only, never allocated
reg_def R33_H (SOC, SOC, Op_RegI, 33, out1->as_VMReg()->next() );
reg_def R34   (SOC, SOC, Op_RegI, 34, out2->as_VMReg()         );  // out2 = c_rarg2: C arguments only, never allocated
reg_def R34_H (SOC, SOC, Op_RegI, 34, out2->as_VMReg()->next() );
reg_def R35   (SOC, SOC, Op_RegI, 35, out3->as_VMReg()         );  // out3 = c_rarg3: C arguments only, never allocated
reg_def R35_H (SOC, SOC, Op_RegI, 35, out3->as_VMReg()->next() );
reg_def R36   (SOC, SOC, Op_RegI, 36, out4->as_VMReg()         );  // out4 = c_rarg4: C arguments only, never allocated
reg_def R36_H (SOC, SOC, Op_RegI, 36, out4->as_VMReg()->next() );
reg_def R37   (SOC, SOC, Op_RegI, 37, out5->as_VMReg()         );  // out5 = c_rarg5: C arguments only, never allocated
reg_def R37_H (SOC, SOC, Op_RegI, 37, out5->as_VMReg()->next() );
reg_def R38   (SOC, SOC, Op_RegI, 38, out6->as_VMReg()         );  // out6 = c_rarg6: C arguments only, never allocated
reg_def R38_H (SOC, SOC, Op_RegI, 38, out6->as_VMReg()->next() );
reg_def R39   (SOC, SOC, Op_RegI, 39, out7->as_VMReg()         );  // out7 = c_rarg7: C arguments only, never allocated
reg_def R39_H (SOC, SOC, Op_RegI, 39, out7->as_VMReg()->next() );

reg_def F0    (NS,  NS,  Op_RegF,  0, f0->as_VMReg()         );  // +0.0
reg_def F0_H  (NS,  NS,  Op_RegF,  0, f0->as_VMReg()->next() );
reg_def F1    (NS,  NS,  Op_RegF,  1, f1->as_VMReg()         );  // +1.0
reg_def F1_H  (NS,  NS,  Op_RegF,  1, f1->as_VMReg()->next() );
reg_def F2    (NS,  SOE, Op_RegF,  2, f2->as_VMReg()         );  // divide/sqrt temporaries (f2-f5)
reg_def F2_H  (NS,  SOE, Op_RegF,  2, f2->as_VMReg()->next() );
reg_def F3    (NS,  SOE, Op_RegF,  3, f3->as_VMReg()         );
reg_def F3_H  (NS,  SOE, Op_RegF,  3, f3->as_VMReg()->next() );
reg_def F4    (NS,  SOE, Op_RegF,  4, f4->as_VMReg()         );
reg_def F4_H  (NS,  SOE, Op_RegF,  4, f4->as_VMReg()->next() );
reg_def F5    (NS,  SOE, Op_RegF,  5, f5->as_VMReg()         );
reg_def F5_H  (NS,  SOE, Op_RegF,  5, f5->as_VMReg()->next() );
reg_def F6    (NS,  SOC, Op_RegF,  6, f6->as_VMReg()         );  // ftmp0
reg_def F6_H  (NS,  SOC, Op_RegF,  6, f6->as_VMReg()->next() );
reg_def F7    (NS,  SOC, Op_RegF,  7, f7->as_VMReg()         );  // ftmp1
reg_def F7_H  (NS,  SOC, Op_RegF,  7, f7->as_VMReg()->next() );
reg_def F8    (SOC, SOC, Op_RegF,  8, f8->as_VMReg()         );  // return value, j_farg0/c_farg0
reg_def F8_H  (SOC, SOC, Op_RegF,  8, f8->as_VMReg()->next() );
reg_def F9    (SOC, SOC, Op_RegF,  9, f9->as_VMReg()         );  // j_farg1/c_farg1
reg_def F9_H  (SOC, SOC, Op_RegF,  9, f9->as_VMReg()->next() );
reg_def F10   (SOC, SOC, Op_RegF, 10, f10->as_VMReg()         );  // j_farg2/c_farg2
reg_def F10_H (SOC, SOC, Op_RegF, 10, f10->as_VMReg()->next() );
reg_def F11   (SOC, SOC, Op_RegF, 11, f11->as_VMReg()         );  // j_farg3/c_farg3
reg_def F11_H (SOC, SOC, Op_RegF, 11, f11->as_VMReg()->next() );
reg_def F12   (SOC, SOC, Op_RegF, 12, f12->as_VMReg()         );  // j_farg4/c_farg4
reg_def F12_H (SOC, SOC, Op_RegF, 12, f12->as_VMReg()->next() );
reg_def F13   (SOC, SOC, Op_RegF, 13, f13->as_VMReg()         );  // j_farg5/c_farg5
reg_def F13_H (SOC, SOC, Op_RegF, 13, f13->as_VMReg()->next() );
reg_def F14   (SOC, SOC, Op_RegF, 14, f14->as_VMReg()         );  // j_farg6/c_farg6
reg_def F14_H (SOC, SOC, Op_RegF, 14, f14->as_VMReg()->next() );
reg_def F15   (SOC, SOC, Op_RegF, 15, f15->as_VMReg()         );  // j_farg7/c_farg7
reg_def F15_H (SOC, SOC, Op_RegF, 15, f15->as_VMReg()->next() );
reg_def F16   (SOC, SOE, Op_RegF, 16, f16->as_VMReg()         );
reg_def F16_H (SOC, SOE, Op_RegF, 16, f16->as_VMReg()->next() );
reg_def F17   (SOC, SOE, Op_RegF, 17, f17->as_VMReg()         );
reg_def F17_H (SOC, SOE, Op_RegF, 17, f17->as_VMReg()->next() );
reg_def F18   (SOC, SOE, Op_RegF, 18, f18->as_VMReg()         );
reg_def F18_H (SOC, SOE, Op_RegF, 18, f18->as_VMReg()->next() );
reg_def F19   (SOC, SOE, Op_RegF, 19, f19->as_VMReg()         );
reg_def F19_H (SOC, SOE, Op_RegF, 19, f19->as_VMReg()->next() );
reg_def F20   (SOC, SOE, Op_RegF, 20, f20->as_VMReg()         );
reg_def F20_H (SOC, SOE, Op_RegF, 20, f20->as_VMReg()->next() );
reg_def F21   (SOC, SOE, Op_RegF, 21, f21->as_VMReg()         );
reg_def F21_H (SOC, SOE, Op_RegF, 21, f21->as_VMReg()->next() );
reg_def F22   (SOC, SOE, Op_RegF, 22, f22->as_VMReg()         );
reg_def F22_H (SOC, SOE, Op_RegF, 22, f22->as_VMReg()->next() );
reg_def F23   (SOC, SOE, Op_RegF, 23, f23->as_VMReg()         );
reg_def F23_H (SOC, SOE, Op_RegF, 23, f23->as_VMReg()->next() );
reg_def F24   (SOC, SOE, Op_RegF, 24, f24->as_VMReg()         );
reg_def F24_H (SOC, SOE, Op_RegF, 24, f24->as_VMReg()->next() );
reg_def F25   (SOC, SOE, Op_RegF, 25, f25->as_VMReg()         );
reg_def F25_H (SOC, SOE, Op_RegF, 25, f25->as_VMReg()->next() );
reg_def F26   (SOC, SOE, Op_RegF, 26, f26->as_VMReg()         );
reg_def F26_H (SOC, SOE, Op_RegF, 26, f26->as_VMReg()->next() );
reg_def F27   (SOC, SOE, Op_RegF, 27, f27->as_VMReg()         );
reg_def F27_H (SOC, SOE, Op_RegF, 27, f27->as_VMReg()->next() );
reg_def F28   (SOC, SOE, Op_RegF, 28, f28->as_VMReg()         );
reg_def F28_H (SOC, SOE, Op_RegF, 28, f28->as_VMReg()->next() );
reg_def F29   (SOC, SOE, Op_RegF, 29, f29->as_VMReg()         );
reg_def F29_H (SOC, SOE, Op_RegF, 29, f29->as_VMReg()->next() );
reg_def F30   (SOC, SOE, Op_RegF, 30, f30->as_VMReg()         );
reg_def F30_H (SOC, SOE, Op_RegF, 30, f30->as_VMReg()->next() );
reg_def F31   (SOC, SOE, Op_RegF, 31, f31->as_VMReg()         );
reg_def F31_H (SOC, SOE, Op_RegF, 31, f31->as_VMReg()->next() );

// ----------------------------
// Special Registers
// ----------------------------
// The condition codes: there is no flags register, so a pseudo register,
// with no VMReg, names the p10/p11 predicate pair (C2-DESIGN.md section 4).
// Only flag producers matched as nodes of their own use it (FastLock,
// FastUnlock, overflow checks); compares are fused into their branches and
// conditional moves.

reg_def RFLAGS (SOC, SOC, 0, 10, VMRegImpl::Bad());

// Specify priority of register selection within phases of register
// allocation.  Highest priority is first.  A useful heuristic is to
// give registers a low priority when they are required by machine
// instructions, and choose no-save registers before save-on-call, &
// save-on-call before save-on-entry.  Registers which participate in fixed
// calling sequences should come last.  Registers which are used as pairs
// must fall on an even boundary.

alloc_class chunk0(
    // allocatable: the C-preserved pair first, scratch, then the Java
    // argument registers last (fewer copies at calls)
    R6, R6_H,
    R7, R7_H,
    R16, R16_H,
    R17, R17_H,
    R29, R29_H,
    R30, R30_H,
    R31, R31_H,
    R28, R28_H,
    R19, R19_H,
    R18, R18_H,
    R15, R15_H,
    R14, R14_H,
    R8, R8_H,
    R27, R27_H,
    R26, R26_H,
    R25, R25_H,
    R24, R24_H,
    R23, R23_H,
    R22, R22_H,
    R21, R21_H,
    R20, R20_H,

    // never allocated
    R32, R32_H,
    R33, R33_H,
    R34, R34_H,
    R35, R35_H,
    R36, R36_H,
    R37, R37_H,
    R38, R38_H,
    R39, R39_H,
    R0, R0_H,
    R1, R1_H,
    R2, R2_H,
    R3, R3_H,
    R4, R4_H,
    R5, R5_H,
    R9, R9_H,
    R10, R10_H,
    R11, R11_H,
    R12, R12_H,
    R13, R13_H
);

alloc_class chunk1(
    // allocatable: C-preserved f16-f31 first (they survive leaf calls), then
    // the argument registers
    F16, F16_H,
    F17, F17_H,
    F18, F18_H,
    F19, F19_H,
    F20, F20_H,
    F21, F21_H,
    F22, F22_H,
    F23, F23_H,
    F24, F24_H,
    F25, F25_H,
    F26, F26_H,
    F27, F27_H,
    F28, F28_H,
    F29, F29_H,
    F30, F30_H,
    F31, F31_H,
    F15, F15_H,
    F14, F14_H,
    F13, F13_H,
    F12, F12_H,
    F11, F11_H,
    F10, F10_H,
    F9, F9_H,
    F8, F8_H,

    // never allocated
    F0, F0_H,
    F1, F1_H,
    F2, F2_H,
    F3, F3_H,
    F4, F4_H,
    F5, F5_H,
    F6, F6_H,
    F7, F7_H
);

alloc_class chunk2(RFLAGS);

//----------Architecture Description Register Classes--------------------------
// Several register classes are automatically defined based upon information in
// this architecture description.
// 1) reg_class inline_cache_reg           ( /* as def'd in frame section */ )
// 2) reg_class stack_slots( /* one chunk of stack-based "registers" */ )
//

// Allocatable int registers (21).
reg_class int_reg(
    R6,
    R7,
    R8,
    R14,
    R15,
    R16,
    R17,
    R18,
    R19,
    R20,
    R21,
    R22,
    R23,
    R24,
    R25,
    R26,
    R27,
    R28,
    R29,
    R30,
    R31
);

// Allocatable long and pointer registers.
reg_class long_reg(
    R6, R6_H,
    R7, R7_H,
    R8, R8_H,
    R14, R14_H,
    R15, R15_H,
    R16, R16_H,
    R17, R17_H,
    R18, R18_H,
    R19, R19_H,
    R20, R20_H,
    R21, R21_H,
    R22, R22_H,
    R23, R23_H,
    R24, R24_H,
    R25, R25_H,
    R26, R26_H,
    R27, R27_H,
    R28, R28_H,
    R29, R29_H,
    R30, R30_H,
    R31, R31_H
);

reg_class ptr_reg(
    R6, R6_H,
    R7, R7_H,
    R8, R8_H,
    R14, R14_H,
    R15, R15_H,
    R16, R16_H,
    R17, R17_H,
    R18, R18_H,
    R19, R19_H,
    R20, R20_H,
