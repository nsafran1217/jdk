  ins_cost(ALU_COST * 2);
  format %{ "cmp.$cop  $op1, $op2 ; (p6) mov $dst, $src\t# @cmovI_cmpU" %}

  ins_encode %{
    __ cmp_preds($cop$$cmpcode, C2_MacroAssembler::cmp_uint, $op1$$Register, $op2$$Register, ptmp0, ptmp1);
    __ mov($dst$$Register, $src$$Register, ptmp0);
  %}

  ins_pipe(ialu_reg_reg);
%}

