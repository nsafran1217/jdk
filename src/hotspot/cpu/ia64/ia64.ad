#include "opto/convertnode.hpp"
#include "runtime/objectMonitor.hpp"

class CallStubImpl {

  //--------------------------------------------------------------
  //---<  Used for optimization in Compile::shorten_branches  >---
  //--------------------------------------------------------------

 public:
  // Size of call trampoline stub.
  static uint size_call_trampoline() {
    return 0; // no call trampolines on this platform
  }

  // number of relocations needed by a call trampoline stub
  static uint reloc_call_trampoline() {
    return 0; // no call trampolines on this platform
  }
};

class HandlerImpl {

 public:

  static int emit_exception_handler(C2_MacroAssembler* masm);
  static int emit_deopt_handler(C2_MacroAssembler* masm);

  // far_jump: movl, mov b6, br.
  static uint size_exception_handler() {
    return 3 * BytesPerBundle;
  }

  // mov ip, mov b0, then far_jump.
  static uint size_deopt_handler() {
    return 5 * BytesPerBundle;
  }
};

// Calls into the code cache (stubs, blobs) are far_calls, unless the stub
// starts with a function descriptor (MacroAssembler::function_entry: stubs
// C++ also calls, such as arraycopy). Those, and C functions, are called
// through the descriptor.
inline bool call_through_descriptor(address entry) {
  return !CodeCache::contains(entry) || MacroAssembler::is_function_entry(entry);
}

class Node::PD {
public:
  enum NodeFlags {
    _last_flag = Node::_last_flag
  };
};

%}

source %{

#define __ masm->

// The ad file has to provide implementations of certain methods
// expected by the generic code.
//
// REQUIRED FUNCTIONALITY

void PhaseOutput::pd_perform_mach_node_analysis() {
}

// Code is always bundle-aligned, which already satisfies every alignment a
// node asks for (OptoLoopAlignment and InteriorEntryAlignment are a bundle).
int MachNode::pd_alignment_required() const {
  return 1;
}

int MachNode::compute_padding(int current_offset) const {
  return 0;
}

//=============================================================================

// Byte offset from the start of each kind of call node to the return address,
// i.e. the end of the br.call bundle. Each call node is a fixed shape:
// MacroAssembler::far_call's seven-bundle cell form (NativeCall,
// FRAME-DESIGN.md 11.2), preceded for dynamic calls by the movl of the
// inline-cache data (ic_call).

int MachCallStaticJavaNode::ret_addr_offset() {
  return NativeCall::instruction_size;
}

int MachCallDynamicJavaNode::ret_addr_offset() {
  return NativeMovConstReg::instruction_size + NativeCall::instruction_size;
}

// Runtime calls: see call_through_descriptor (source_hpp). A descriptor
// call is the anchor's pc store (mov ip, adds, adds, st8), then call_c's movl
// entry, movl gp, mov b6, br.call; anything else a far_call.
int MachCallRuntimeNode::ret_addr_offset() {
  if (call_through_descriptor(_entry_point)) {
    return 8 * BytesPerBundle;
  } else {
    return NativeCall::instruction_size;
  }
}

