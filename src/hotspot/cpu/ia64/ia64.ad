  ins_cost(LOAD_COST);
  format %{ "ld4  $dst, $mem\t# compressed class, @loadNKlass" %}

  ins_encode %{
    __ access(C2_MacroAssembler::op_ld4, $dst$$reg, as_Register($mem$$base), $mem$$disp);
  %}

  ins_pipe(pipe_class_memory);
%}

