//=============================================================================
// Prolog and epilog (C2-DESIGN.md section 8). The frame is C1's
// (FRAME-DESIGN.md 4.2, 4.5): return address and the caller's fp in the two
// words below the caller's sp, fp = the caller's sp, sp lowered by the frame
// size, whose bottom 16 bytes are the psABI scratch area (the 4 out-preserve
// slots). The frame size includes both.

#ifndef PRODUCT
void MachPrologNode::format(PhaseRegAlloc* ra_, outputStream* st) const {
  Compile* C = ra_->C;

  int framesize = C->output()->frame_size_in_bytes();
  int bangsize = C->output()->bang_size_in_bytes();

  st->print("nop\t# patchable verified entry\n\t");
  if (C->output()->need_stack_bang(bangsize)) {
    st->print("# stack bang size=%d\n\t", bangsize);
  }
  st->print("mov t2 = b0\n\t");
  st->print("mov t3 = sp\n\t");
  st->print("sp -= %d\n\t", framesize);
  st->print("st8 [t3 - 8] = t2\t# return address\n\t");
  st->print("st8 [t3 - 16] = fp\n\t");
  st->print("mov fp = t3");
  if (C->stub_function() == nullptr) {
    st->print("\n\t# nmethod entry barrier");
  }
}
#endif

void MachPrologNode::emit(C2_MacroAssembler* masm, PhaseRegAlloc* ra_) const {
  Compile* C = ra_->C;

  // n.b. frame size includes space for return pc and fp
  const int framesize = C->output()->frame_size_in_bytes();
  assert(is_aligned(framesize, StackAlignmentInBytes), "frame size must keep sp aligned");

  // The verified entry starts with a nop bundle, which make_not_entrant
  // replaces (NativeJump::patch_verified_entry).
  __ nop();

  // VM_Version::supports_fast_class_init_checks() is false.
  assert(!C->clinit_barrier_on_entry(), "no clinit barriers on IA-64");

  int bangsize = C->output()->bang_size_in_bytes();
  if (C->output()->need_stack_bang(bangsize)) {
    __ generate_stack_overflow_check(bangsize);
  }

  // As C1_MacroAssembler::build_frame. sp moves before anything is stored
  // below it: there is no red zone. t2/t3 are free at a method entry.
  __ mov_from_br(t2, breturn);
  __ mov(t3, sp);                                 // the new fp
  __ add_imm(sp, sp, -framesize);
  __ adds(t1, frame::return_addr_offset * wordSize, t3);
  __ Assembler::st8(t1, t2);
  __ adds(t1, frame::link_offset * wordSize, t3);
  __ Assembler::st8(t1, fp);
  __ mov(fp, t3);

  if (C->stub_function() == nullptr) {
    // Must end the prologue: BarrierSetNMethod finds the guard at a fixed
    // distance before the frame-complete offset.
    BarrierSetAssembler* bs = BarrierSet::barrier_set()->barrier_set_assembler();
    bs->nmethod_entry_barrier(masm);
  }

  if (VerifyStackAtCalls) {
    Unimplemented();
  }

  C->output()->set_frame_complete(__ offset());
}

uint MachPrologNode::size(PhaseRegAlloc* ra_) const {
  return MachNode::size(ra_); // too many variables; just compute it the hard way
}

int MachPrologNode::reloc() const {
  return 0;
}

//=============================================================================

// Whether a method's result is an int the interpreter will read as its
// sign-extended top of stack (C2-DESIGN.md section 3).
static bool returns_int(Compile* C) {
  if (C->method() == nullptr) {
    return false;
  }
  switch (C->tf()->return_type()) {
    case T_BOOLEAN: case T_CHAR: case T_BYTE: case T_SHORT: case T_INT:
      return true;
    default:
      return false;
  }
}

#ifndef PRODUCT
void MachEpilogNode::format(PhaseRegAlloc* ra_, outputStream* st) const {
  Compile* C = ra_->C;
  if (returns_int(C)) {
    st->print("sxt4 r8 = r8\t# int result\n\t");
  }
  st->print("# pop frame %d\n\t", C->output()->frame_size_in_bytes());
  st->print("ld8 t0 = [fp - 8]\t# return address\n\t");
  st->print("ld8 t1 = [fp - 16]\n\t");
  st->print("mov sp = fp\n\t");
  st->print("mov fp = t1\n\t");
  st->print("mov b0 = t0");
  if (do_polling() && C->is_method_compilation()) {
    st->print("\n\t# test polling word\n\t");
    st->print("ld8 t1 = [Rthread + #%d]\n\t", in_bytes(JavaThread::polling_word_offset()));
    st->print("cmp.ltu p6 = t1, sp ; (p6) br slow_path");
  }
}
#endif

void MachEpilogNode::emit(C2_MacroAssembler* masm, PhaseRegAlloc* ra_) const {
  Compile* C = ra_->C;

  if (returns_int(C)) {
    // The interpreter's return entry takes r8 as its sign-extended int top
    // of stack; compiled code keeps only the low 32 bits defined.
    __ sxt4(r8, r8);
  }

  // fp is the caller's sp: removing the frame is leave(), which leaves the
  // return address in b0.
  __ leave();

  if (StackReservedPages > 0 && C->has_reserved_stack_access()) {
    // As C1's return_op: the frame is gone and b0 holds the return address;
    // an access to the reserved zone enables it and throws as though from
    // the caller.
    Label no_reserved_zone_enabling;
    __ ld8(t2, Address(Rthread, JavaThread::reserved_stack_activation_offset()));
    __ bltu(sp, t2, no_reserved_zone_enabling);
    __ enter();
    __ mov(c_rarg0, Rthread);
    __ call_c(CAST_FROM_FN_PTR(address, SharedRuntime::enable_stack_reserved_zone));
    __ leave();
    __ far_jump(SharedRuntime::throw_delayed_StackOverflowError_entry());
    __ bind(no_reserved_zone_enabling);
  }

  if (do_polling() && C->is_method_compilation()) {
    Label dummy_label;
    Label* code_stub = &dummy_label;
    if (!C->output()->in_scratch_emit_size()) {
      C2SafepointPollStub* stub = new (C->comp_arena()) C2SafepointPollStub(__ offset());
      C->output()->add_stub(stub);
      code_stub = &stub->entry();
    }
    __ relocate(relocInfo::poll_return_type);
    __ safepoint_poll(*code_stub, true /* at_return */, false /* acquire */, true /* in_nmethod */);
  }
}

uint MachEpilogNode::size(PhaseRegAlloc* ra_) const {
  // Variable size. Determine dynamically.
  return MachNode::size(ra_);
}

int MachEpilogNode::reloc() const {
  // Return number of relocatable values contained in this instruction.
  return 1; // 1 for polling page.
}

const Pipeline* MachEpilogNode::pipeline() const {
  return MachNode::pipeline_class();
}

//=============================================================================

// Figure out which register class each belongs in: rc_int, rc_float or
// rc_stack.
enum RC { rc_bad, rc_int, rc_float, rc_stack };

static enum RC rc_class(OptoReg::Name reg) {

  if (reg == OptoReg::Bad) {
    return rc_bad;
  }

  // the general registers come first, two halves each
  int slots_of_int_registers = Register::max_slots_per_register * Register::number_of_registers;
  if (reg < slots_of_int_registers) {
    return rc_int;
  }

  // then the floating-point registers
  int slots_of_float_registers = FloatRegister::max_slots_per_register * FloatRegister::number_of_registers;
  if (reg < slots_of_int_registers + slots_of_float_registers) {
    return rc_float;
  }

  // Between the float registers and the stack is the flags pseudo register.
  assert(OptoReg::is_stack(reg), "blow up if spilling flags");

  return rc_stack;
}

// Spills are typed by ideal register (C2-DESIGN.md section 10): stfs/ldfs
// for a float, stfd/ldfd for a double -- a register must hold a value of
// the type its store names (ISA-NOTES.md, "Floating point"). FP register
// moves are fmerge.s, which copies every bit, never fnorm.
uint MachSpillCopyNode::implementation(C2_MacroAssembler* masm, PhaseRegAlloc* ra_, bool do_size, outputStream* st) const {
  // Get registers to move.
  OptoReg::Name src_hi = ra_->get_reg_second(in(1));
  OptoReg::Name src_lo = ra_->get_reg_first(in(1));
  OptoReg::Name dst_hi = ra_->get_reg_second(this);
  OptoReg::Name dst_lo = ra_->get_reg_first(this);

  enum RC src_lo_rc = rc_class(src_lo);
  enum RC dst_lo_rc = rc_class(dst_lo);

  assert(src_lo != OptoReg::Bad && dst_lo != OptoReg::Bad, "must move at least 1 register");

  if (src_hi != OptoReg::Bad) {
    assert((src_lo & 1) == 0 && src_lo + 1 == src_hi &&
           (dst_lo & 1) == 0 && dst_lo + 1 == dst_hi,
           "expected aligned-adjacent pairs");
  }

  if (src_lo == dst_lo && src_hi == dst_hi) {
    return 0;            // Self copy, no move.
  }

  bool is64 = (src_lo & 1) == 0 && src_lo + 1 == src_hi &&
              (dst_lo & 1) == 0 && dst_lo + 1 == dst_hi;
  int src_offset = ra_->reg2offset(src_lo);
  int dst_offset = ra_->reg2offset(dst_lo);
  // A 32-bit value that is not an int (a narrow klass) is kept zero-extended.
  bool zext32 = !is64 && ideal_reg() != Op_RegI;

  assert(bottom_type()->isa_vect() == nullptr, "no vectors on IA-64");

  if (masm != nullptr) {
    switch (src_lo_rc) {
      case rc_int: {
        Register src = as_Register(Matcher::_regEncode[src_lo]);
        if (dst_lo_rc == rc_int) {           // gpr --> gpr copy
          Register dst = as_Register(Matcher::_regEncode[dst_lo]);
          if (zext32) {
            __ zxt4(dst, src);
          } else {
            __ mov(dst, src);
          }
        } else if (dst_lo_rc == rc_float) {  // gpr --> fpr copy
          FloatRegister dst = as_FloatRegister(Matcher::_regEncode[dst_lo]);
          if (is64) {
            __ setf_d(dst, src);
          } else {
            __ setf_s(dst, src);
          }
        } else {                             // gpr --> stack spill
          assert(dst_lo_rc == rc_stack, "spill to bad register class");
          if (is64) {
            __ st8(Address(sp, dst_offset), src);
          } else {
            __ st4(Address(sp, dst_offset), src);
          }
        }
        break;
      }
      case rc_float: {
        FloatRegister src = as_FloatRegister(Matcher::_regEncode[src_lo]);
        if (dst_lo_rc == rc_int) {           // fpr --> gpr copy
          Register dst = as_Register(Matcher::_regEncode[dst_lo]);
          if (is64) {
            __ getf_d(dst, src);
          } else {
            __ getf_s(dst, src);
          }
        } else if (dst_lo_rc == rc_float) {  // fpr --> fpr copy
          __ fmov(as_FloatRegister(Matcher::_regEncode[dst_lo]), src);
        } else {                             // fpr --> stack spill
          assert(dst_lo_rc == rc_stack, "spill to bad register class");
          if (is64) {
            __ stfd(Address(sp, dst_offset), src);
          } else {
            __ stfs(Address(sp, dst_offset), src);
          }
        }
        break;
      }
      case rc_stack:
        if (dst_lo_rc == rc_int) {           // stack --> gpr load
          Register dst = as_Register(Matcher::_regEncode[dst_lo]);
          if (is64) {
            __ ld8(dst, Address(sp, src_offset));
          } else {
            // ld4 zero-extends: right for a narrow klass, and an int's
            // upper half is undefined anyway.
            __ ld4(dst, Address(sp, src_offset));
          }
        } else if (dst_lo_rc == rc_float) {  // stack --> fpr load
          FloatRegister dst = as_FloatRegister(Matcher::_regEncode[dst_lo]);
          if (is64) {
            __ ldfd(dst, Address(sp, src_offset));
          } else {
            __ ldfs(dst, Address(sp, src_offset));
          }
        } else {                             // stack --> stack copy
          assert(dst_lo_rc == rc_stack, "spill to bad register class");
          if (is64) {
            __ ld8(t1, Address(sp, src_offset));
            __ st8(Address(sp, dst_offset), t1);
          } else {
            __ ld4(t1, Address(sp, src_offset));
            __ st4(Address(sp, dst_offset), t1);
          }
        }
        break;
      default:
        ShouldNotReachHere();
    }
  }

  if (st != nullptr) {
    st->print("spill ");
    if (src_lo_rc == rc_stack) {
      st->print("[sp, #%d] -> ", src_offset);
    } else {
      st->print("%s -> ", Matcher::regName[src_lo]);
    }
    if (dst_lo_rc == rc_stack) {
      st->print("[sp, #%d]", dst_offset);
    } else {
      st->print("%s", Matcher::regName[dst_lo]);
    }
    st->print("\t# spill size = %d", is64 ? 64 : 32);
  }

  return 0;
}

#ifndef PRODUCT
void MachSpillCopyNode::format(PhaseRegAlloc* ra_, outputStream* st) const {
  if (ra_ == nullptr) {
    st->print("N%d = SpillCopy(N%d)", _idx, in(1)->_idx);
  } else {
    implementation(nullptr, ra_, false, st);
  }
}
#endif

void MachSpillCopyNode::emit(C2_MacroAssembler* masm, PhaseRegAlloc* ra_) const {
  implementation(masm, ra_, false, nullptr);
}

uint MachSpillCopyNode::size(PhaseRegAlloc* ra_) const {
  return MachNode::size(ra_);
}

//=============================================================================

#ifndef PRODUCT
void BoxLockNode::format(PhaseRegAlloc* ra_, outputStream* st) const {
  int offset = ra_->reg2offset(in_RegMask(0).find_first_elem());
  int reg = ra_->get_reg_first(this);
  st->print("adds %s = #%d, sp\t# box lock", Matcher::regName[reg], offset);
}
#endif

void BoxLockNode::emit(C2_MacroAssembler* masm, PhaseRegAlloc* ra_) const {
  int offset = ra_->reg2offset(in_RegMask(0).find_first_elem());
  Register reg = as_Register(ra_->get_encode(this));
  __ add_imm(reg, sp, offset, t0);
}

uint BoxLockNode::size(PhaseRegAlloc* ra_) const {
  // BoxLockNode is not a MachNode, so we can't just call MachNode::size(ra_).
  int offset = ra_->reg2offset(in_RegMask(0).find_first_elem());
  return (ia64::is_simm14(offset) ? 1 : 2) * BytesPerBundle;
}

//=============================================================================

#ifndef PRODUCT
void MachUEPNode::format(PhaseRegAlloc* ra_, outputStream* st) const {
  st->print_cr("# MachUEPNode");
  st->print_cr("\tld4 t3 = [j_rarg0 + oopDesc::klass_offset_in_bytes()]\t# compressed klass");
  st->print_cr("\tld4 t2 = [t1 + CompiledICData::speculated_klass_offset()]\t# compressed klass");
  st->print_cr("\tcmp4.eq p6, p7 = t2, t3 ; (p7) br SharedRuntime::_ic_miss_stub\t# Inline cache check");
}
#endif

void MachUEPNode::emit(C2_MacroAssembler* masm, PhaseRegAlloc* ra_) const {
  // This is the unverified entry point.
  __ ic_check(CodeEntryAlignment);

  // ic_check() aligns so that the verified entry, which follows, is
  // CodeEntryAlignment-aligned.
  assert(((__ offset()) % CodeEntryAlignment) == 0, "Misaligned verified entry point");
}

uint MachUEPNode::size(PhaseRegAlloc* ra_) const {
  return MachNode::size(ra_);
}

// REQUIRED EMIT CODE

//=============================================================================

// Emit exception handler code.
int HandlerImpl::emit_exception_handler(C2_MacroAssembler* masm) {
  // Note that the code buffer's insts_mark is always relative to insts.
  // That's why we must use the macroassembler to generate a handler.
  address base = __ start_a_stub(size_exception_handler());
  if (base == nullptr) {
    ciEnv::current()->record_failure("CodeCache is full");
    return 0;  // CodeBuffer::expand failed
  }
  int offset = __ offset();
  __ far_jump(OptoRuntime::exception_blob()->entry_point());
  assert(__ offset() - offset <= (int) size_exception_handler(), "overflow");
  __ end_a_stub();
  return offset;
}

// Emit deopt handler code.
int HandlerImpl::emit_deopt_handler(C2_MacroAssembler* masm) {
  address base = __ start_a_stub(size_deopt_handler());
  if (base == nullptr) {
    ciEnv::current()->record_failure("CodeCache is full");
    return 0;  // CodeBuffer::expand failed
  }
  int offset = __ offset();

  // As C1's deopt handler: the deopt blob is entered with b0 = this
  // handler's own address, which is how it recognises the frame being
  // deoptimized (riscv: auipc ra, 0).
  __ mov_from_ip(t2);
  __ mov_to_br(breturn, t2);
  __ far_jump(SharedRuntime::deopt_blob()->unpack());

  assert(__ offset() - offset <= (int) size_deopt_handler(), "overflow");
  __ end_a_stub();
  return offset;
}

