  format %{ "fabs  $dst, $src\t# double, @absD_reg" %}

  ins_encode %{
    __ fabs($dst$$FloatRegister, $src$$FloatRegister);
  %}

  ins_pipe(fp_default);
%}

instruct sqrtD_reg(fRegD dst, fRegD src)
%{
  match(Set dst (SqrtD src));

  ins_cost(FSQRT_COST);
  format %{ "fsqrt.d  $dst, $src\t# @sqrtD_reg" %}

  ins_encode %{
    __ fsqrt_d($dst$$FloatRegister, $src$$FloatRegister);
  %}

  ins_pipe(pipe_slow);
%}

